<div class="row"><div class="col-lg-5"><div class="card card-outline" style="border-top-color:#6f42c1"><div class="card-header"><h3 class="card-title"><i class="fas fa-print mr-2" style="color:#6f42c1"></i>Admission letter printing</h3></div><form method="post" action="/staff/admissions/letter-printing"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="card-body"><div class="form-group"><label>Academic session</label><select id="printingSession" name="session_id" class="form-control" required><% sessions.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(x.id)===Number(sessionId)?'selected':'' %>><%= x.name %></option><% }) %></select></div><div class="form-group"><label>Application type</label><select name="application_form_id" class="form-control" required><option value="">Select</option><% forms.filter(x=>Number(x.session_id)===Number(sessionId)).forEach(x=>{ %><option value="<%= x.id %>"><%= x.title %></option><% }) %></select></div><p class="text-muted mb-0">Applicants must also complete their acceptance and compulsory fee payments before the letter can be printed.</p></div><div class="card-footer"><button name="enabled" value="1" class="btn text-white mr-2" style="background:#6f42c1"><i class="fas fa-lock-open mr-1"></i>Enable printing</button><button name="enabled" value="0" class="btn btn-outline-secondary"><i class="fas fa-lock mr-1"></i>Disable printing</button></div></form></div></div><div class="col-lg-7"><div class="card"><div class="card-header"><h3 class="card-title">Current status</h3></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Application type</th><th>Session</th><th>Printing</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="3" class="text-center text-muted py-4">No application type was found for this session.</td></tr><% } rows.forEach(x=>{ %><tr><td><strong><%= x.title %></strong></td><td><%= x.session_name %></td><td><span class="badge badge-<%= x.letter_printing_enabled?'success':'secondary' %>"><%= x.letter_printing_enabled?'ENABLED':'DISABLED' %></span></td></tr><% }) %></tbody></table></div></div></div></div><script>document.getElementById('printingSession')?.addEventListener('change',function(){location.href='/staff/admissions/letter-printing?session_id='+encodeURIComponent(this.value)});</script>
