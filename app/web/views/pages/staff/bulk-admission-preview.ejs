<div class="card card-outline card-warning">
  <div class="card-header"><h3 class="card-title">Review bulk admission</h3></div>
  <div class="card-body">
    <% const duplicates=rows.filter(x=>x.duplicate&&!x.error).length,blocked=rows.filter(x=>x.error).length; %>
    <% (sessionStats||[]).forEach(stat=>{ %><div class="alert alert-info"><strong><%= Number(stat.admitted_count).toLocaleString() %> applicant(s)</strong> have already been admitted for <%= stat.session_name %>.</div><% }) %>
    <% if(duplicates){ %><div class="alert alert-warning"><strong><%= duplicates %> applicant(s) are already admitted.</strong> Confirming will replace their current placement only where acceptance has not been paid and Student Portal access has not been created.</div><% } %>
    <% if(blocked){ %><div class="alert alert-danger"><strong><%= blocked %> row(s) cannot be processed.</strong> Review the reason shown below.</div><% } %>
    <div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Row</th><th>Applicant</th><th>Application</th><th>Current programme</th><th>Offered placement</th><th>Result</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr class="<%= row.error?'table-danger':row.duplicate?'table-warning':'' %>"><td><%= row.rowNumber %></td><td><%= row.applicant_name||'—' %></td><td><%= row.applicationNumber %></td><td><%= row.programme_choice||'—' %></td><td><strong><%= row.programme_name||row.acronym||'—' %></strong><br><small><%= [row.school_name,row.department_name].filter(Boolean).join(' / ') %></small></td><td><%= row.error|| (row.duplicate?'Will update existing admission':'Ready') %></td></tr><% }) %></tbody></table></div>
  </div>
  <div class="card-footer"><form method="post" action="/staff/admissions/bulk-upload/confirm" class="d-inline"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><button class="btn btn-success" onclick="return confirm('Issue or update admission for every valid row shown?')">Confirm valid admissions</button></form> <a href="/staff/admissions/manage" class="btn btn-secondary">Cancel</a></div>
</div>
