<div class="finance-report">
  <div class="row modern-metrics">
    <div class="col-lg-3 col-6"><div class="metric-card accent-danger" data-icon="&#xf071;"><span>Debtors</span><strong><%= summary.debtors %></strong><small>Students with outstanding balances</small></div></div>
    <div class="col-lg-3 col-6"><div class="metric-card accent-amber" data-icon="&#xf53a;"><span>Total outstanding</span><strong>₦<%= Number(summary.totalDebt).toLocaleString() %></strong><small>Confirmed session obligation</small></div></div>
    <div class="col-lg-3 col-6"><div class="metric-card accent-blue" data-icon="&#xf4c0;"><span>Creditors</span><strong><%= summary.creditors %></strong><small>Students with credit balances</small></div></div>
    <div class="col-lg-3 col-6"><div class="metric-card accent-violet" data-icon="&#xf555;"><span>Total credit</span><strong>₦<%= Number(summary.totalCredit).toLocaleString() %></strong><small>For Bursary review</small></div></div>
  </div>
  <div class="card modern-panel"><div class="card-body"><form method="get" class="form-row">
    <div class="form-group col-md-2"><label>Session</label><select name="session_id" class="form-control"><% sessions.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(filters.sessionId)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div>
    <div class="form-group col-md-2"><label>School</label><select name="school_id" id="balanceSchool" class="form-control"><option value="">All schools</option><% schools.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(filters.schoolId)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div>
    <div class="form-group col-md-2"><label>Department</label><select name="department_id" id="balanceDepartment" class="form-control"><option value="">All departments</option><% departments.forEach(x=>{ %><option value="<%= x.id %>" data-school="<%= x.school_id %>" <%= Number(filters.departmentId)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div>
    <div class="form-group col-md-2"><label>Programme</label><select name="programme_id" id="balanceProgramme" class="form-control"><option value="">All programmes</option><% programmes.forEach(x=>{ %><option value="<%= x.id %>" data-school="<%= x.school_id %>" data-department="<%= x.department_id %>" <%= Number(filters.programmeId)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div>
    <div class="form-group col-md-3"><label>Student search</label><input class="form-control" name="q" value="<%= filters.q %>" placeholder="Name, matric or email"></div><div class="form-group col-md-1 d-flex align-items-end"><button class="btn btn-primary btn-block">Apply</button></div>
  </form><% const reportParams={session_id:filters.sessionId||'',school_id:filters.schoolId||'',department_id:filters.departmentId||'',programme_id:filters.programmeId||'',q:filters.q||''}; %><div class="d-flex flex-wrap"><a class="btn btn-sm btn-outline-success mr-2" href="?<%= new URLSearchParams({...reportParams,type:'DEBTOR'}).toString() %>">Debtors</a><a class="btn btn-sm btn-outline-primary mr-auto" href="?<%= new URLSearchParams({...reportParams,type:'CREDITOR'}).toString() %>">Creditors</a><% ['csv','xlsx','pdf'].forEach(f=>{ %><a class="btn btn-sm btn-light ml-2" href="/staff/fees/debtors-creditors/export/<%= f %>?<%= new URLSearchParams({...reportParams,type:query?.type||''}).toString() %>"><%= f.toUpperCase() %></a><% }) %></div></div></div>
  <div class="card modern-panel"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Student</th><th>School / Department</th><th>Programme</th><th class="text-right">Expected</th><th class="text-right">Paid</th><th class="text-right">Balance</th><th>Status</th></tr></thead><tbody><% const displayRows=rows.filter(x=>!query?.type||(query.type==='DEBTOR'?x.balance>0:query.type==='CREDITOR'?x.balance<0:true)); if(!displayRows.length){ %><tr><td colspan="7" class="text-center text-muted py-5">No matching balances.</td></tr><% } displayRows.forEach(x=>{ %><tr><td><strong><%= x.full_name %></strong><br><small><%= x.matric_number||x.email %></small></td><td><%= x.school_name||'-' %><br><small><%= x.department_name||'-' %></small></td><td><%= x.programme_name||'-' %></td><td class="text-right">₦<%= Number(x.expected).toLocaleString() %></td><td class="text-right">₦<%= Number(x.paid).toLocaleString() %></td><td class="text-right font-weight-bold">₦<%= Math.abs(Number(x.balance)).toLocaleString() %></td><td><span class="status-pill status-<%= x.status.toLowerCase() %>"><%= x.status %></span></td></tr><% }) %></tbody></table></div></div>
  <% if (!obligationCount) { %><div class="alert alert-warning border"><i class="fas fa-exclamation-triangle mr-1"></i>No compulsory fees have been configured for this session, so the portal cannot calculate debtors yet. Please mark the relevant payment types as <strong>Compulsory obligation</strong> and assign them to this session.</div><% } %>
  <div class="alert alert-light border"><i class="fas fa-info-circle mr-1"></i>This report uses payment types marked <strong>Compulsory obligation</strong>. If your account has a confirmed overpayment, please contact the Bursary for refund processing where applicable.</div>
</div>
