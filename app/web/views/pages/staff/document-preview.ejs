<!doctype html>
<html><head><meta charset="utf-8"><title>Document Preview</title><style>
@page{size:A4;margin:16mm}body{margin:0;background:#eef1f5;font-family:Arial,sans-serif;color:#222}.actions{position:sticky;top:0;background:#172033;color:#fff;padding:12px;text-align:center;z-index:3}.actions button{padding:8px 18px}.page{position:relative;width:180mm;min-height:267mm;margin:24px auto;background:#fff;padding:15mm;box-shadow:0 12px 40px #9aa3ad;overflow:hidden}.head{text-align:center;border-bottom:2px solid #82103c;padding:0 25mm 15px;position:relative;z-index:2}.head>img{width:70px;position:absolute;left:0;top:0}.head h1{font-size:20px;color:#247d57;margin:0 0 5px}.head p{margin:3px}.title{text-align:center;color:#82103c;margin:30px 0;position:relative;z-index:2}.body{line-height:1.65;position:relative;z-index:2}.watermark-text{position:absolute;inset:42% 0 auto;transform:rotate(-35deg);font-size:64px;text-align:center;font-weight:bold;color:#777;pointer-events:none}.watermark-grid{position:absolute;inset:115px 28px 65px;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);align-items:center;justify-items:center;pointer-events:none}.watermark-grid img{width:95px;max-height:105px;object-fit:contain}.personal-watermarks{position:absolute;inset:165px -55px 65px;display:flex;flex-direction:column;justify-content:space-around;pointer-events:none;transform:rotate(-24deg);color:#d71920;font-size:18px;font-weight:700;opacity:.11;text-align:center;white-space:nowrap}.sample-qr{position:absolute;right:15mm;top:15mm;width:60px;text-align:center;z-index:3;font-size:9px;color:#555}.sample-qr img{width:60px;display:block;margin-bottom:3px}@media print{body{background:#fff}.actions{display:none}.page{box-shadow:none;margin:0;width:auto;min-height:auto;padding:0}}
</style></head><body>
<div class="actions"><button onclick="window.print()">Print / Save as PDF</button></div>
<main class="page">
  <% if(template.watermark_text){ %><div class="watermark-text" style="opacity:<%= template.watermark_opacity %>"><%= template.watermark_text %></div><% } %>
  <% if(template.watermark_image_path){ %><div class="watermark-grid" style="opacity:<%= template.watermark_opacity %>"><% for(let i=0;i<9;i++){ %><img src="<%= template.watermark_image_path %>" alt=""><% } %></div><% } %>
  <% if(template.personal_watermark){ %><div class="personal-watermarks"><% for(let i=0;i<4;i++){ %><div><%= template.personal_watermark %></div><% } %></div><% } %>
  <header class="head"><img src="/public/img/logo.png"><h1>EKITI STATE COLLEGE OF TECHNOLOGY</h1><p>IJERO-EKITI, EKITI STATE</p><p>P.M.B. 316, Epe Ara Road, Ijero-Ekiti, Ekiti State</p><div style="clear:both"></div></header>
  <h2 class="title"><%= template.title %></h2><section class="body"><%- template.body_html %></section>
  <% if(template.registrar_signature_path||template.registrar_name||template.registrar_position){ %><div style="position:relative;z-index:2;margin-top:45px;width:260px"><% if(template.registrar_signature_path){ %><img src="<%= template.registrar_signature_path %>" alt="Registrar signature" style="display:block;max-width:145px;max-height:58px;object-fit:contain"><% } %><strong><%= template.registrar_name||'Registrar' %></strong><br><span><%= template.registrar_position||'Registrar' %></span></div><% } %>
  <% if(template.qr_data_url && ['ADMISSION_LETTER','SCREENING_SLIP'].includes(template.document_type)){ %><div class="sample-qr"><img src="<%= template.qr_data_url %>" alt="Verification code">Verification Code</div><% } %>
</main></body></html>
