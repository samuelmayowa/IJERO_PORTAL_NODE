<div class="card card-outline card-primary"><div class="card-header"><h3 class="card-title"><%= type[0].toUpperCase()+type.slice(1) %> passwords</h3></div><div class="card-body">
<form method="get" class="form-row mb-3"><div class="col-md-9"><input name="q" value="<%= q %>" class="form-control" placeholder="Search by name, <%= type==='staff'?'staff number':'matric number' %>, email or phone"></div><div class="col-md-3"><button class="btn btn-primary btn-block">Search</button></div></form>
<div class="alert alert-light border">Default password: <strong>College1</strong></div>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th><%= type==='staff'?'Staff number':'Matric number' %></th><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th></th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="6" class="text-center text-muted py-4">No users found.</td></tr><% } %><% rows.forEach(row=>{ %><tr><td><%= row.identifier||'—' %></td><td><strong><%= row.name||'—' %></strong></td><td><%= row.email||'—' %></td><td><%= row.phone||'—' %></td><td><span class="badge badge-<%= row.status==='ACTIVE'?'success':'secondary' %>"><%= row.status %></span></td><td><div class="d-flex flex-wrap"><form method="post" action="/staff/password/<%= type %>/<%= row.id %>/reset" class="mr-1 mb-1"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><button class="btn btn-sm btn-warning" onclick="return confirm('Reset this password to College1?')">Reset to College1</button></form><button type="button" class="btn btn-sm btn-primary mb-1 js-custom-password" data-id="<%= row.id %>" data-name="<%= row.name||row.email||'user' %>">Custom password</button></div></td></tr><% }) %></tbody></table></div>
<nav><ul class="pagination mb-0"><li class="page-item <%= page<=1?'disabled':'' %>"><a class="page-link" href="?q=<%= encodeURIComponent(q) %>&page=<%= page-1 %>">Previous</a></li><li class="page-item disabled"><span class="page-link">Page <%= page %> of <%= totalPages %></span></li><li class="page-item <%= page>=totalPages?'disabled':'' %>"><a class="page-link" href="?q=<%= encodeURIComponent(q) %>&page=<%= page+1 %>">Next</a></li></ul></nav>
</div></div>

<div class="modal fade" id="customPasswordModal" tabindex="-1" role="dialog" aria-labelledby="customPasswordTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document"><form id="customPasswordForm" method="post" class="modal-content">
    <input type="hidden" name="_csrf" value="<%= csrfToken||'' %>">
    <div class="modal-header"><h5 class="modal-title" id="customPasswordTitle">Set custom password</h5><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div>
    <div class="modal-body">
      <p class="text-muted">Changing password for <strong id="customPasswordUser"></strong>.</p>
      <div class="form-group"><label>New password</label><input type="password" name="password" id="customPassword" class="form-control" minlength="8" maxlength="128" autocomplete="new-password" required><small class="text-muted">Use at least 8 characters.</small></div>
      <div class="form-group mb-0"><label>Confirm password</label><input type="password" name="confirm_password" id="customPasswordConfirm" class="form-control" minlength="8" maxlength="128" autocomplete="new-password" required></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-light" data-dismiss="modal">Cancel</button><button class="btn btn-primary">Save custom password</button></div>
  </form></div>
</div>
<script>
(function(){
  const modal=document.getElementById('customPasswordModal'),form=document.getElementById('customPasswordForm');
  document.querySelectorAll('.js-custom-password').forEach(function(button){button.addEventListener('click',function(){
    form.action='/staff/password/<%= type %>/'+encodeURIComponent(button.dataset.id)+'/change';
    document.getElementById('customPasswordUser').textContent=button.dataset.name||'user';
    form.reset(); window.jQuery(modal).modal('show');
  })});
  form.addEventListener('submit',function(event){
    const password=document.getElementById('customPassword').value,confirmation=document.getElementById('customPasswordConfirm').value;
    if(password!==confirmation){event.preventDefault();document.getElementById('customPasswordConfirm').setCustomValidity('Passwords do not match.');document.getElementById('customPasswordConfirm').reportValidity();}
  });
  document.getElementById('customPasswordConfirm').addEventListener('input',function(){this.setCustomValidity('')});
})();
</script>
