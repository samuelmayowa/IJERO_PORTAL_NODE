<% const money=v=>Number(v||0).toLocaleString('en-NG',{minimumFractionDigits:2,maximumFractionDigits:2}); const errors=messages&&messages.error?(Array.isArray(messages.error)?messages.error:[messages.error]):[]; %>
<div class="card card-outline card-primary">
  <div class="card-header"><h3 class="card-title"><i class="fas fa-file-invoice-dollar mr-2"></i>Pay Compulsory Fee</h3></div>
  <div class="card-body p-0">
    <% errors.filter(Boolean).forEach(message=>{ %><div class="alert alert-danger m-3"><i class="fas fa-exclamation-circle mr-1"></i><%= message %></div><% }) %>
    <% if(!applications.length){ %><div class="p-5 text-center"><i class="fas fa-info-circle fa-3x text-info mb-3"></i><h4>No Eligible Application Found</h4><p class="text-muted mb-0">Compulsory-fee payment becomes available after admission and confirmed acceptance-fee payment.</p></div><% }else{ %>
    <div class="table-responsive"><table class="table table-bordered table-hover mb-0"><thead><tr><th>Application</th><th>Application Number</th><th>Acceptance Fee</th><th>Compulsory Charges</th><th>Status</th><th>Action</th></tr></thead><tbody>
      <% applications.forEach(item=>{const accepted=String(item.acceptance_payment_status||'').toUpperCase()==='PAID';const paid=String(item.compulsory_payment_status||'').toUpperCase()==='PAID'||String(item.invoice_status||'').toUpperCase()==='PAID';const configured=Number(item.compulsory_payment_type_id)>0&&Number(item.compulsory_payment_type_active)===1&&Number(item.is_compulsory)===1&&String(item.remita_service_type_id||'').trim()&&Number(item.configured_compulsory_total)>0; %>
      <tr><td><strong><%= item.application_title %></strong><% if(item.category){ %><br><small class="text-muted"><%= item.category %></small><% } %></td><td><%= item.application_number||'—' %></td><td><span class="badge badge-<%= accepted?'success':'warning' %>"><%= accepted?'Paid':'Required' %></span></td><td>₦<%= money(item.configured_compulsory_total) %></td><td><span class="badge badge-<%= paid?'success':item.order_id?'warning':'secondary' %>"><%= paid?'Paid':item.order_id?'Pending':'Not started' %></span></td><td>
        <% if(!accepted){ %><div class="alert alert-warning py-2 mb-0">Acceptance fee payment is required before compulsory-fee payment.</div><% }else if(!configured){ %><span class="text-muted">Compulsory fee is not yet configured. Please contact Bursary.</span><% }else if(paid){ %><a class="btn btn-sm btn-outline-success" href="/payment/print/<%= encodeURIComponent(item.order_id) %>?type=receipt&dl=0"><i class="fas fa-receipt mr-1"></i>View receipt</a><% }else{ %><form method="post" action="/applicant/payments/compulsory/<%= item.id %>/start"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><button class="btn btn-sm btn-primary"><i class="fas fa-credit-card mr-1"></i><%= item.order_id?'Continue payment':'Pay now' %></button></form><% } %>
      </td></tr><% }) %>
    </tbody></table></div><% } %>
  </div>
</div>
