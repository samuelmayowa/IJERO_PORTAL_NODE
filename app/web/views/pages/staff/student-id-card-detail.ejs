<style>.id-preview{max-width:780px;margin:auto;border-radius:22px;overflow:hidden;border:1px solid #d7e4df;box-shadow:0 20px 55px rgba(16,42,34,.14)}.id-head{display:flex;gap:16px;align-items:center;padding:22px;background:linear-gradient(135deg,#064c38,#0b8060);color:#fff}.id-logo{width:70px;height:70px;object-fit:contain;background:#fff;padding:7px;border-radius:50%}.id-body{display:grid;grid-template-columns:150px 1fr 180px;gap:24px;padding:26px;background:#fff}.id-passport{width:150px;height:180px;object-fit:cover;border-radius:12px;border:1px solid #d7e4df}.id-qr{width:180px;height:180px}.id-details{display:grid;grid-template-columns:120px 1fr;gap:8px 12px}.id-label{font-size:11px;text-transform:uppercase;color:#687b74}.id-value{font-weight:700}.id-status{display:inline-block;padding:5px 10px;border-radius:99px;background:#e8f7f0;color:#086b4c;font-weight:700}.id-status.inactive{background:#fff1f0;color:#b42318}@media(max-width:850px){.id-body{grid-template-columns:1fr}.id-passport,.id-qr{margin:auto}}</style>
<div class="mb-3"><a class="btn btn-outline-secondary" href="/staff/student-id-cards"><i class="fas fa-arrow-left mr-1"></i>All cards</a> <a class="btn btn-success" href="/staff/student-id-cards/<%= student.public_user_id %>/qr.svg"><i class="fas fa-download mr-1"></i>Download labelled QR</a> <a class="btn btn-outline-success" href="<%= verificationUrl %>" target="_blank" rel="noopener"><i class="fas fa-external-link-alt mr-1"></i>Open verification page</a></div>
<section class="id-preview"><header class="id-head"><img class="id-logo" src="/public/img/logo.png" alt="College logo"><div><h3 class="mb-1"><%= schoolName %></h3><div><%= schoolAddress %></div></div></header><div class="id-body"><img class="id-passport" src="<%= student.photo_path?('/public'+String(student.photo_path).replace(/^\/public/,'')):'/public/img/avatar.png' %>" alt="Student passport"><div><h3><%= student.full_name %></h3><p><span class="id-status <%= student.card_status==='ACTIVE'?'':'inactive' %>"><%= student.card_status %></span></p><div class="id-details"><div class="id-label">Matric number</div><div class="id-value"><%= student.matric_number||'Not recorded' %></div><div class="id-label">School</div><div class="id-value"><%= student.school %></div><div class="id-label">Department</div><div class="id-value"><%= student.department %></div><div class="id-label">Programme</div><div class="id-value"><%= student.programme %></div><div class="id-label">Level</div><div class="id-value"><%= student.level %></div><div class="id-label">Year of entry</div><div class="id-value"><%= student.year_of_entry %></div></div></div><div class="text-center"><img class="id-qr" src="<%= qrDataUrl %>" alt="Verification QR code"><small class="d-block mt-2"><strong><%= student.matric_number||'NO MATRIC NUMBER' %></strong></small></div></div></section><div class="alert alert-light border mt-3"><strong>Verification URL</strong><br><code style="word-break:break-all"><%= verificationUrl %></code></div>
