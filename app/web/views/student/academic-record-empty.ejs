<div class="row">
  <div class="col-12">
    <div class="card card-outline card-success">
      <div class="card-header"><h3 class="card-title"><i class="fas <%= meta.icon %> mr-2 text-success"></i><%= meta.title %></h3></div>
      <div class="card-body">
        <p class="text-muted"><%= meta.description %></p>
        <form method="GET" class="form-row align-items-end mt-3">
          <div class="form-group col-md-5">
            <label for="recordSession">Academic Session</label>
            <select id="recordSession" name="session_id" class="form-control">
              <% sessions.forEach(function(session){ %><option value="<%= session.id %>" <%= String(session.id) === selectedSessionId ? 'selected' : '' %>><%= session.name %><%= Number(session.is_current) === 1 ? ' (Current)' : '' %></option><% }); %>
            </select>
          </div>
          <div class="form-group col-md-5">
            <label for="recordSemester">Semester</label>
            <select id="recordSemester" name="semester_id" class="form-control">
              <% semesters.forEach(function(semester){ %><option value="<%= semester.id %>" <%= String(semester.id) === selectedSemesterId ? 'selected' : '' %>><%= semester.name %><%= Number(semester.is_current) === 1 ? ' (Current)' : '' %></option><% }); %>
            </select>
          </div>
          <div class="form-group col-md-2"><button class="btn btn-success btn-block" type="submit"><i class="fas fa-filter mr-1"></i> Check</button></div>
        </form>
        <div class="text-center border rounded py-5 px-3 mt-3" style="background:rgba(36,125,87,.035)">
          <i class="fas <%= meta.icon %> text-success mb-3" style="font-size:2.5rem;opacity:.55"></i>
          <h5>Your record is not available yet</h5>
          <p class="text-muted mb-3"><%= meta.empty %></p>
          <% if (recordType === 'approved') { %><a class="btn btn-outline-success btn-sm" href="/student/results/semester">Open semester result checker</a><% } %>
        </div>
      </div>
    </div>
  </div>
</div>
