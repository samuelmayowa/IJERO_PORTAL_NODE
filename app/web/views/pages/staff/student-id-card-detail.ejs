<style>
.id-preview{--school-wine:#82103c;position:relative;max-width:780px;margin:auto;border-radius:22px;overflow:hidden;border:1px solid #d7e4df;box-shadow:0 20px 55px rgba(16,42,34,.14);background:#fff}.id-preview>*{position:relative;z-index:2}.id-head{display:flex;gap:16px;align-items:center;padding:22px;background:linear-gradient(135deg,#064c38,#0b8060);color:#fff}.id-logo{width:70px;height:70px;object-fit:contain;background:#fff;padding:7px;border-radius:50%}.id-body{display:grid;grid-template-columns:150px 1fr 180px;gap:24px;padding:26px;background:rgba(255,255,255,.88)}.id-passport{width:150px;height:180px;object-fit:cover;border-radius:12px;border:1px solid #d7e4df}.id-qr{width:180px;height:180px}.id-details{display:grid;grid-template-columns:120px 1fr;gap:8px 12px}.id-label{font-size:11px;text-transform:uppercase;color:#687b74}.id-value{font-weight:700}.id-status{display:inline-block;margin-top:8px;padding:6px 13px;border-radius:99px;background:#e8f7f0;color:#086b4c;font-weight:800;letter-spacing:.06em}.id-status.inactive{background:#fff1f0;color:#b42318}.id-footer{padding:12px 20px;text-align:center;background:var(--school-wine);color:#fff;font-size:13px;font-weight:700;letter-spacing:.035em}.id-watermarks{position:absolute;z-index:1;inset:108px 0 40px;overflow:hidden;pointer-events:none;opacity:.065;display:grid;grid-template-columns:repeat(3,1fr);align-content:space-around;transform:rotate(-18deg) scale(1.1)}.id-watermark{display:flex;align-items:center;gap:8px;white-space:nowrap;color:#102a22;font-weight:800;font-size:13px;padding:8px}.id-watermark img{width:28px;height:28px;object-fit:contain}.verification-box{display:flex;align-items:center;gap:12px}.verification-box code{flex:1;word-break:break-all}.copy-feedback{min-width:88px}@media(max-width:850px){.id-body{grid-template-columns:1fr}.id-passport,.id-qr{margin:auto}.id-watermarks{grid-template-columns:repeat(2,1fr)}}
</style>
<div class="mb-3"><a class="btn btn-outline-secondary" href="/staff/student-id-cards"><i class="fas fa-arrow-left mr-1"></i>All cards</a> <a class="btn btn-success" href="/staff/student-id-cards/<%= student.public_user_id %>/qr.svg"><i class="fas fa-download mr-1"></i>Download labelled QR</a> <a class="btn btn-outline-success" href="<%= verificationUrl %>" target="_blank" rel="noopener"><i class="fas fa-external-link-alt mr-1"></i>Open verification page</a></div>
<section class="id-preview"><div class="id-watermarks" aria-hidden="true"><% for(let i=0;i<9;i+=1){ %><div class="id-watermark"><img src="/public/img/logo.png" alt=""><span><%= student.full_name %> · <%= student.matric_number||'NO MATRIC' %></span></div><% } %></div><header class="id-head"><img class="id-logo" src="/public/img/logo.png" alt="College logo"><div><h3 class="mb-1"><%= schoolName %></h3><div><%= schoolAddress %></div></div></header><div class="id-body"><img class="id-passport" src="<%= photoUrl %>" alt="Student passport"><div><h3><%= student.full_name %></h3><div class="id-details"><div class="id-label">Matric number</div><div class="id-value"><%= student.matric_number||'Not recorded' %></div><div class="id-label">School</div><div class="id-value"><%= student.school %></div><div class="id-label">Department</div><div class="id-value"><%= student.department %></div><div class="id-label">Programme</div><div class="id-value"><%= student.programme %></div><div class="id-label">Level</div><div class="id-value"><%= student.level %></div><div class="id-label">Year of entry</div><div class="id-value"><%= student.year_of_entry %></div></div></div><div class="text-center"><img class="id-qr" src="<%= qrDataUrl %>" alt="Verification QR code"><small class="d-block mt-2"><strong><%= student.matric_number||'NO MATRIC NUMBER' %></strong></small><span class="id-status <%= student.card_status==='ACTIVE'?'':'inactive' %>"><%= student.card_status %></span></div></div><footer class="id-footer">Powered by Directorate of ICT</footer></section>
<div class="alert alert-light border mt-3 verification-box"><div class="flex-grow-1"><strong>Verification URL</strong><br><code id="verification-url"><%= verificationUrl %></code></div><button type="button" class="btn btn-outline-success copy-feedback" id="copy-verification-url"><i class="far fa-copy mr-1"></i>Copy</button></div>
<script>
document.getElementById('copy-verification-url')?.addEventListener('click',async function(){const value=document.getElementById('verification-url')?.textContent?.trim()||'';try{if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(value)}else{const field=document.createElement('textarea');field.value=value;field.style.position='fixed';field.style.opacity='0';document.body.appendChild(field);field.select();document.execCommand('copy');field.remove()}this.innerHTML='<i class="fas fa-check mr-1"></i>Copied';setTimeout(()=>{this.innerHTML='<i class="far fa-copy mr-1"></i>Copy'},1800)}catch{this.textContent='Select URL'}});
</script>
