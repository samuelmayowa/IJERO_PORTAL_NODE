<div class="row"><div class="col-lg-5"><div class="card card-outline card-primary"><div class="card-header"><h3 class="card-title">Find portal user</h3></div><div class="card-body">
<form method="get"><div class="form-group"><label>User type</label><select name="type" class="form-control" onchange="this.form.submit()"><% ['student','applicant','staff'].forEach(x=>{ %><option value="<%= x %>" <%= type===x?'selected':'' %>><%= x[0].toUpperCase()+x.slice(1) %></option><% }) %></select></div><div class="input-group"><input name="q" value="<%= q %>" class="form-control" placeholder="Name, email, phone or number"><div class="input-group-append"><button class="btn btn-primary">Search</button></div></div></form>
<div class="list-group mt-3"><% rows.forEach(row=>{ %><a class="list-group-item list-group-item-action <%= Number(editing?.id)===Number(row.id)?'active':'' %>" href="?type=<%= type %>&q=<%= encodeURIComponent(q) %>&page=<%= page %>&edit=<%= row.id %>"><strong><%= row.name||'—' %></strong><br><small><%= row.identifier||row.email||'' %> · <%= row.phone||'' %></small></a><% }) %></div>
<nav class="mt-3"><a class="btn btn-sm btn-outline-secondary <%= page<=1?'disabled':'' %>" href="?type=<%= type %>&q=<%= encodeURIComponent(q) %>&page=<%= page-1 %>">Previous</a> <span class="mx-2"><%= page %> / <%= totalPages %></span><a class="btn btn-sm btn-outline-secondary <%= page>=totalPages?'disabled':'' %>" href="?type=<%= type %>&q=<%= encodeURIComponent(q) %>&page=<%= page+1 %>">Next</a></nav>
</div></div></div><div class="col-lg-7"><div class="card"><div class="card-header"><h3 class="card-title">Edit <%= type %> biodata</h3></div><% if(!editing){ %><div class="card-body text-muted">Select a user to edit.</div><% }else{ %><form method="post" action="/staff/password/edit-details/<%= type %>/<%= editing.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="card-body"><div class="form-row"><div class="form-group col-md-4"><label>First name</label><input name="first_name" class="form-control" value="<%= editing.first_name||'' %>" required></div><div class="form-group col-md-4"><label>Middle name</label><input name="middle_name" class="form-control" value="<%= editing.middle_name||'' %>"></div><div class="form-group col-md-4"><label>Surname</label><input name="last_name" class="form-control" value="<%= editing.last_name||'' %>" required></div></div><div class="form-row"><div class="form-group col-md-6"><label>Email/login</label><input type="email" name="email" class="form-control" value="<%= editing.email||editing.username||'' %>" required></div><div class="form-group col-md-3"><label>Phone</label><input name="phone" class="form-control" value="<%= editing.phone||'' %>"></div><div class="form-group col-md-3"><label>Status</label><select name="status" class="form-control"><option <%= editing.status==='ACTIVE'?'selected':'' %>>ACTIVE</option><option <%= editing.status==='INACTIVE'?'selected':'' %>>INACTIVE</option></select></div></div><% if(type!=='staff'){ %><div class="form-row"><div class="form-group col-md-3"><label>Date of birth</label><input type="date" name="dob" class="form-control" value="<%= editing.dob?new Date(editing.dob).toISOString().slice(0,10):'' %>"></div><div class="form-group col-md-3"><label>Gender</label><input name="gender" class="form-control" value="<%= editing.gender||'' %>"></div><div class="form-group col-md-3"><label>State</label><input name="state_of_origin" class="form-control" value="<%= editing.state_of_origin||'' %>"></div><div class="form-group col-md-3"><label>LGA</label><input name="lga" class="form-control" value="<%= editing.lga||'' %>"></div></div><div class="form-group"><label>Address</label><textarea name="address" class="form-control"><%= editing.address||'' %></textarea></div><% } %></div><div class="card-footer"><button class="btn btn-success">Save biodata</button><% if(type==='applicant'){ %> <a class="btn btn-outline-primary" href="/staff/admissions/manage">Admission applicants</a><% }else if(type==='student'){ %> <a class="btn btn-outline-primary" href="/staff/students/edit">Academic placement</a><% } %></div></form><% } %></div></div></div>
