<div class="row"><div class="col-lg-5"><div class="card card-outline card-success"><div class="card-header"><h3 class="card-title">Configure compulsory fees</h3></div><form method="post" action="/staff/fees/programme-compulsory-fees"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="card-body">
<div class="form-group"><label>Application type and session</label><select name="application_form_id" class="form-control" required><option value="">Select</option><% forms.forEach(x=>{ %><option value="<%= x.id %>"><%= x.title %> · <%= x.session_name %></option><% }) %></select></div>
<div class="form-row"><div class="form-group col-md-6"><label>School</label><select id="feeSchool" class="form-control"><option value="">All schools</option><% schools.forEach(x=>{ %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select></div><div class="form-group col-md-6"><label>Department</label><select id="feeDepartment" class="form-control"><option value="">All departments</option><% departments.forEach(x=>{ %><option value="<%= x.id %>" data-school="<%= x.school_id %>"><%= x.name %></option><% }) %></select></div></div>
<label>Programmes</label><div id="programmeChoices" class="border rounded p-2 mb-3" style="max-height:220px;overflow:auto"><% programmes.forEach(x=>{ %><div class="custom-control custom-checkbox programme-choice" data-school="<%= x.school_id %>" data-department="<%= x.department_id %>"><input class="custom-control-input" type="checkbox" name="programme_ids" value="<%= x.id %>" id="feeProgramme<%= x.id %>"><label class="custom-control-label" for="feeProgramme<%= x.id %>"><%= x.name %><%= x.acronym?' ('+x.acronym+')':'' %></label></div><% }) %></div>
<div class="custom-control custom-checkbox mb-3"><input class="custom-control-input" type="checkbox" name="apply_all" value="1" id="applyAllProgrammes"><label class="custom-control-label" for="applyAllProgrammes">Apply to every programme that does not already have a compulsory fee</label></div>
<label>Charges</label><div id="chargeRows"><div class="form-row charge-row"><div class="form-group col-7"><input name="charge_name" class="form-control" value="Compulsory Fee" required></div><div class="form-group col-4"><input type="number" name="charge_amount" min="0" step="0.01" class="form-control" placeholder="Amount" required></div><div class="col-1"><button type="button" class="btn btn-outline-danger remove-charge">×</button></div></div></div><button type="button" id="addCharge" class="btn btn-sm btn-outline-primary"><i class="fas fa-plus mr-1"></i>Add charge</button>
</div><div class="card-footer"><button class="btn btn-success">Save compulsory fees</button></div></form></div></div>
<div class="col-lg-7"><div class="card"><div class="card-header"><h3 class="card-title">Configured programme fees</h3></div><div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Application</th><th>Programme</th><th>Charge</th><th>Amount</th><th></th></tr></thead><tbody><% if(!rules.length){ %><tr><td colspan="5" class="text-center text-muted py-4">No programme compulsory fees configured.</td></tr><% } %><% rules.forEach(row=>{ %><tr><td><%= row.application_title %><br><small><%= row.session_name %></small></td><td><%= row.programme_name %></td><td><%= row.charge_name %></td><td>₦<%= Number(row.amount).toLocaleString() %></td><td><form method="post" action="/staff/fees/programme-compulsory-fees/<%= row.id %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this charge?')">Remove</button></form></td></tr><% }) %></tbody></table></div></div></div></div>
<script>document.addEventListener('DOMContentLoaded',function(){var s=document.getElementById('feeSchool'),d=document.getElementById('feeDepartment'),box=document.getElementById('programmeChoices'),rows=document.getElementById('chargeRows');function filter(){Array.from(d.options).forEach(o=>o.hidden=!!o.value&&!!s.value&&o.dataset.school!==s.value);box.querySelectorAll('.programme-choice').forEach(x=>x.hidden=!!s.value&&x.dataset.school!==s.value||!!d.value&&x.dataset.department!==d.value)}s.addEventListener('change',function(){d.value='';filter()});d.addEventListener('change',filter);document.getElementById('addCharge').addEventListener('click',function(){var clone=rows.firstElementChild.cloneNode(true);clone.querySelector('[name=charge_name]').value='';clone.querySelector('[name=charge_amount]').value='';rows.appendChild(clone)});rows.addEventListener('click',function(e){var b=e.target.closest('.remove-charge');if(!b)return;if(rows.children.length===1){b.closest('.charge-row').querySelector('[name=charge_amount]').value='';return}b.closest('.charge-row').remove()});filter()});</script>
