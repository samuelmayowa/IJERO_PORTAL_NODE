<div class="row"><div class="col-lg-7"><div class="card card-outline card-success"><div class="card-header"><h3 class="card-title">Correct applicant record</h3></div><form method="post" action="/staff/admissions/applicants/<%= application.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="card-body"><div class="alert alert-info"><strong><%= application.application_number %></strong> · <%= application.application_title %> · <%= application.session_name %><br>This page updates Applicant information only. It does not edit an existing Student record.</div><div class="form-row"><div class="form-group col-md-4"><label>First name</label><input name="first_name" class="form-control" value="<%= application.first_name %>" required></div><div class="form-group col-md-4"><label>Middle name</label><input name="middle_name" class="form-control" value="<%= application.middle_name||'' %>"></div><div class="form-group col-md-4"><label>Surname</label><input name="last_name" class="form-control" value="<%= application.last_name %>" required></div></div><div class="form-group"><label>Email/login</label><input class="form-control" value="<%= application.username %>" readonly></div><div class="form-row"><div class="form-group col-md-4"><label>School</label><select id="editSchool" name="school_id" class="form-control" required><option value="">Select</option><% schools.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(choice.school_id)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div><div class="form-group col-md-4"><label>Department</label><select id="editDepartment" name="department_id" class="form-control" required><option value="">Select</option><% departments.forEach(x=>{ %><option value="<%= x.id %>" data-school="<%= x.school_id %>" <%= Number(choice.department_id)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div><div class="form-group col-md-4"><label>Programme</label><select id="editProgramme" name="programme_id" class="form-control" required><option value="">Select</option><% programmes.forEach(x=>{ %><option value="<%= x.id %>" data-school="<%= x.school_id %>" data-department="<%= x.department_id %>" <%= Number(choice.programme_id)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div></div><div class="form-group"><label>Reason for correction</label><textarea name="reason" class="form-control" required placeholder="Explain why this record is being corrected."></textarea></div></div><div class="card-footer"><button class="btn btn-success">Save correction</button><a href="/staff/admissions/manage" class="btn btn-secondary">Back</a></div></form></div>
<div class="card"><div class="card-header"><h3 class="card-title">Replace passport photograph</h3></div><form method="post" enctype="multipart/form-data" action="/staff/admissions/applicants/<%= application.id %>/passport/passport"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="card-body"><p>Current: <%= documents[0]?.original_filename||'No passport uploaded' %></p><div class="form-group"><input type="file" name="document" class="form-control-file" accept="image/jpeg,image/png" required></div><div class="form-group"><label>Reason for replacement</label><textarea name="reason" class="form-control" required></textarea></div><small class="text-muted">JPG or PNG only, maximum 5 MB. The actual image signature is checked before storage.</small></div><div class="card-footer"><button class="btn btn-primary">Replace passport</button></div></form></div></div>
<div class="col-lg-5"><div class="card"><div class="card-header"><h3 class="card-title">Correction history</h3></div><div class="card-body p-0"><div class="list-group list-group-flush"><% if(!audits.length){ %><div class="p-3 text-muted">No corrections recorded.</div><% } %><% audits.forEach(a=>{ %><div class="list-group-item"><strong><%= a.action.replaceAll('_',' ') %></strong><small class="float-right"><%= new Date(a.created_at).toLocaleString('en-GB') %></small><% if(a.reason){ %><p class="mb-0 mt-2"><%= a.reason %></p><% } %><small class="text-muted">By <%= a.actor_role||'system' %></small></div><% }) %></div></div></div></div></div>
<script>document.addEventListener('DOMContentLoaded',function(){var s=document.getElementById('editSchool'),d=document.getElementById('editDepartment'),p=document.getElementById('editProgramme');function f(){Array.from(d.options).forEach(o=>o.hidden=!!o.value&&!!s.value&&o.dataset.school!==s.value);Array.from(p.options).forEach(o=>o.hidden=!!o.value&&((s.value&&o.dataset.school!==s.value)||(d.value&&o.dataset.department!==d.value)))}s.addEventListener('change',()=>{d.value='';p.value='';f()});d.addEventListener('change',()=>{p.value='';f()});f()});</script>
