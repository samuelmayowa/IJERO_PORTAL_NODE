<div class="container py-5" style="max-width:760px"><div class="card shadow-sm"><div class="card-body p-5 text-center"><img src="/public/img/logo.png" width="90" alt="College logo"><h2 class="mt-3">Choose your portal</h2><p class="text-muted">Your account has access to more than one portal. Choose where you want to continue.</p><div class="row justify-content-center mt-4"><% roles.forEach(role=>{ %><div class="col-sm-6 mb-3"><form method="post" action="/portal/switch/<%= role %>"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><button class="btn btn-<%= role==='student'?'primary':'success' %> btn-lg btn-block py-4"><i class="fas fa-<%= role==='student'?'graduation-cap':'file-signature' %> d-block mb-2"></i><%= role==='student'?'Student Portal':'Applicant Portal' %></button></form></div><% }) %></div></div></div></div>
