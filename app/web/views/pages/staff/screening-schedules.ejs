<div class="row"><div class="col-lg-5"><div class="card card-outline card-success"><div class="card-header"><h3 class="card-title">Set screening date</h3></div><form method="post" action="/staff/admissions/screening"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="card-body"><div class="form-group"><label>Session</label><select name="session_id" class="form-control"><% sessions.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(s.id)===Number(sessionId)?'selected':'' %>><%= s.name %></option><% }) %></select></div><div class="form-group"><label>Application type</label><select name="application_form_id" class="form-control"><option value="">All application types</option><% forms.filter(f=>Number(f.session_id)===Number(sessionId)).forEach(f=>{ %><option value="<%= f.id %>"><%= f.title %></option><% }) %></select></div><div class="form-row"><div class="form-group col-md-4"><label>School</label><select name="school_id" class="form-control"><option value="">All</option><% schools.forEach(x=>{ %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select></div><div class="form-group col-md-4"><label>Department</label><select name="department_id" class="form-control"><option value="">All</option><% departments.forEach(x=>{ %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select></div><div class="form-group col-md-4"><label>Programme</label><select name="programme_id" class="form-control"><option value="">All</option><% programmes.forEach(x=>{ %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select></div></div><div class="form-group"><label>Individual application ID (optional override)</label><input type="number" name="applicant_application_id" class="form-control"></div><div class="form-group"><label>Screening type</label><input name="screening_type" class="form-control" value="Entrance Screening"></div><div class="form-row"><div class="form-group col-6"><label>Date</label><input type="date" name="screening_date" class="form-control" required></div><div class="form-group col-3"><label>Report</label><input type="time" name="reporting_time" class="form-control"></div><div class="form-group col-3"><label>Start</label><input type="time" name="start_time" class="form-control"></div></div><div class="form-group"><label>Venue</label><input name="venue" class="form-control" required></div><div class="form-group"><label>Batch</label><input name="batch_name" class="form-control"></div><div class="form-group"><label>Instructions</label><textarea name="instructions" class="form-control"></textarea></div><div class="custom-control custom-checkbox"><input class="custom-control-input" id="publishNow" type="checkbox" name="publish_now" value="1"><label class="custom-control-label" for="publishNow">Publish immediately</label></div></div><div class="card-footer"><button class="btn btn-success">Save screening schedule</button></div></form></div></div><div class="col-lg-7"><div class="card"><div class="card-header"><h3 class="card-title">Schedules</h3></div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Date</th><th>Scope</th><th>Venue</th><th>Status</th><th></th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="5" class="text-center text-muted py-4">No screening schedules configured.</td></tr><% } %><% rows.forEach(row=>{ %><tr><td><strong><%= new Date(row.screening_date).toLocaleDateString('en-GB') %></strong><br><small><%= row.reporting_time||row.start_time||'' %></small></td><td><%= row.application_number||row.programme_name||row.department_name||row.school_name||row.application_title||'All applicants' %></td><td><%= row.venue %></td><td><span class="badge badge-<%= row.status==='PUBLISHED'?'success':row.status==='CANCELLED'?'danger':'secondary' %>"><%= row.status %></span></td><td><form method="post" action="/staff/admissions/screening/<%= row.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><select name="status" class="form-control form-control-sm" onchange="this.form.submit()"><% ['DRAFT','PUBLISHED','CANCELLED'].forEach(x=>{ %><option <%= row.status===x?'selected':'' %>><%= x %></option><% }) %></select></form></td></tr><% }) %></tbody></table></div></div></div></div>
