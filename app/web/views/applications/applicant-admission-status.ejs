<% const money=v=>Number(v||0).toLocaleString('en-NG',{minimumFractionDigits:2,maximumFractionDigits:2});const dateTime=v=>v?new Date(v).toLocaleString('en-GB',{dateStyle:'medium',timeStyle:'short'}):'—'; %>
<div class="card card-outline card-success"><div class="card-header"><h3 class="card-title"><i class="fas fa-user-check mr-2"></i>Your admission status</h3></div><div class="card-body">
<% if(!applications.length){ %><div class="alert alert-info mb-0">You do not yet have a submitted application to check.</div><% } %>
<% applications.forEach(item=>{const admitted=item.decision_status==='ADMITTED',revoked=item.decision_status==='REVOKED'||item.status==='WITHDRAWN',summary=item.fee_summary||{},acceptance=summary.acceptance||{},compulsory=summary.compulsory||{},applicationFee=summary.application||{},fullyPaid=Number(acceptance.outstanding||0)<=0&&Number(compulsory.outstanding||0)<=0,printingEnabled=Number(item.letter_printing_enabled)===1,canPrint=admitted&&fullyPaid&&printingEnabled&&Number(item.has_published_letter_template); %>
<div class="card mb-3 <%= admitted?'border-success':revoked?'border-danger':'' %>"><div class="card-body"><div class="d-flex justify-content-between flex-wrap"><div><h5><%= item.application_title %></h5><p class="text-muted mb-2"><%= item.application_number %> · <%= item.session_name %></p></div><span class="badge badge-<%= admitted?'success':revoked?'danger':'warning' %> p-2"><%= admitted?'OFFERED ADMISSION':revoked?'ADMISSION REVOKED':'UNDER CONSIDERATION' %></span></div>
<% if(admitted){ %><div class="alert alert-success"><h5>Congratulations!</h5><p class="mb-0">You have been offered provisional admission<%= item.offered_programme_name?` to study ${item.offered_programme_name}`:'' %>.</p></div><a href="/applicant/payments/acceptance" class="btn btn-success"><i class="fas fa-credit-card mr-1"></i>Acceptance fee</a> <a href="/applicant/payments/compulsory" class="btn btn-primary"><i class="fas fa-file-invoice-dollar mr-1"></i>Compulsory fee</a> <% if(Number(item.has_published_notification_template)){ %><a target="_blank" href="/applicant/admission/<%= item.id %>/notification" class="btn btn-outline-primary"><i class="fas fa-file-alt mr-1"></i>Print admission notification</a><% } %> <button class="btn btn-outline-success" data-toggle="modal" data-target="#letterStatus<%= item.id %>"><i class="fas fa-file-pdf mr-1"></i>Print admission letter</button>
<div class="modal fade" id="letterStatus<%= item.id %>" tabindex="-1" role="dialog" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered" role="document"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Admission letter</h5><button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button></div><div class="modal-body">
<% if(!printingEnabled){ %><div class="alert alert-info"><strong>Your admission is being processed.</strong><br>Please check back later.</div><% } %>
<div class="table-responsive"><table class="table table-sm table-bordered"><thead><tr><th>Payment</th><th>Expected</th><th>Paid</th><th>Balance</th><th>Payment date</th></tr></thead><tbody><% [['Application fee',applicationFee],['Acceptance fee',acceptance],['Compulsory fee',compulsory]].forEach(entry=>{const payments=(entry[1].payments||[]).filter(x=>x.status==='PAID'); %><tr><td><strong><%= entry[0] %></strong><% if(entry[1].credit>0){ %><br><span class="badge badge-info">Credit ₦<%= money(entry[1].credit) %></span><% } %></td><td>₦<%= money(entry[1].expected) %></td><td>₦<%= money(entry[1].paid) %></td><td>₦<%= money(entry[1].outstanding) %></td><td><% if(!payments.length){ %>—<% } payments.forEach(p=>{ %><div><%= dateTime(p.paid_at) %></div><% }) %></td></tr><% }) %></tbody></table></div>
<div class="alert alert-<%= summary.totalOutstanding>0?'warning':summary.totalCredit>0?'info':'success' %> mb-0"><strong>Indebtedness status:</strong> ₦<%= money(summary.totalOutstanding) %><% if(summary.totalCredit>0){ %><br>Your account has a credit of ₦<%= money(summary.totalCredit) %>. Please contact the Bursary if you need a refund.<% } %></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-dismiss="modal">Close</button><% if(canPrint){ %><a target="_blank" href="/applicant/admission/<%= item.id %>/letter" class="btn btn-success"><i class="fas fa-print mr-1"></i>Open admission letter</a><% }else if(!fullyPaid){ %><a href="<%= Number(acceptance.outstanding)>0?'/applicant/payments/acceptance':'/applicant/payments/compulsory' %>" class="btn btn-primary">Pay outstanding balance</a><% } %></div></div></div></div>
<% }else if(revoked){ %><div class="alert alert-danger mb-0">This admission offer has been revoked. Please contact the Registry.</div><% }else{ %><p class="mb-0">Your application is still being considered. Updates will appear here and in your notifications.</p><% } %></div></div><% }) %></div></div>
