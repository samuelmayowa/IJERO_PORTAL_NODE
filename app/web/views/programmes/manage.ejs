<section class="content-header"><h1><%= pageTitle %></h1></section>
<section class="content">
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <div class="alert alert-info" style="border-left:4px solid #17a2b8">
    These settings define programme progression only. Saving this page does not promote or modify any student.
  </div>
  <div class="card card-outline card-success">
    <div class="card-header"><h3 class="card-title">Add Programme</h3></div>
    <form method="post" action="/staff/programmes/create">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body"><div class="form-row">
        <div class="form-group col-lg-2 col-md-4"><label>School</label><select name="school_id" id="newProgrammeSchool" class="form-control" required><option value="">Select</option><% schools.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></div>
        <div class="form-group col-lg-3 col-md-4"><label>Department</label><select name="department_id" id="newProgrammeDepartment" class="form-control" required><option value="">Select</option><% departments.forEach(d=>{ %><option value="<%= d.id %>" data-school="<%= d.school_id %>"><%= d.name %></option><% }) %></select></div>
        <div class="form-group col-lg-3 col-md-4"><label>Programme name</label><input name="name" class="form-control" required></div>
        <div class="form-group col-lg-1 col-md-4"><label>Acronym</label><input name="acronym" class="form-control text-uppercase" maxlength="30"></div>
        <div class="form-group col-lg-1 col-md-4"><label>Entry</label><select name="entry_level" class="form-control" required><option value="">Select</option><% levels.forEach(x=>{ %><option value="<%= x %>"><%= x %></option><% }) %></select></div>
        <div class="form-group col-lg-2 col-md-4"><label>Graduating level</label><select name="graduating_level" class="form-control" required><option value="">Select</option><% levels.forEach(x=>{ %><option value="<%= x %>"><%= x %></option><% }) %></select></div>
      </div><button class="btn btn-success">Add Programme</button></div>
    </form>
  </div>
  <div class="card card-outline card-primary">
    <div class="card-header d-flex align-items-center"><h3 class="card-title">Existing Programmes</h3><form class="form-inline ml-auto"><input name="q" value="<%= q %>" class="form-control form-control-sm mr-2" placeholder="Search programme…"><button class="btn btn-sm btn-outline-primary">Search</button></form></div>
    <div class="card-body p-0"><div class="table-responsive"><table class="table table-striped table-hover mb-0">
      <thead><tr><th>Programme</th><th>School / Department</th><th style="width:130px">Entry</th><th style="width:160px">Graduating</th><th style="width:100px">Action</th></tr></thead>
      <tbody>
      <% if (!programmes.length) { %><tr><td colspan="5" class="text-center text-muted p-4">No programmes found.</td></tr><% } %>
      <% programmes.forEach((p,index)=>{ %>
        <% const formId='programmeForm'+p.id; %>
        <tr>
          <td><input form="<%= formId %>" name="name" value="<%= p.name %>" class="form-control mb-2" required><input form="<%= formId %>" name="acronym" value="<%= p.acronym||'' %>" class="form-control form-control-sm text-uppercase" placeholder="Acronym" maxlength="30"></td>
          <td><select form="<%= formId %>" name="school_id" class="form-control form-control-sm programme-school mb-2" data-row="<%= index %>" required><% schools.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(s.id)===Number(p.school_id)?'selected':'' %>><%= s.name %></option><% }) %></select><select form="<%= formId %>" name="department_id" class="form-control form-control-sm programme-department" data-row="<%= index %>" required><% departments.forEach(d=>{ %><option value="<%= d.id %>" data-school="<%= d.school_id %>" <%= Number(d.id)===Number(p.department_id)?'selected':'' %>><%= d.name %></option><% }) %></select></td>
          <td><select form="<%= formId %>" name="entry_level" class="form-control" required><option value="">Select</option><% levels.forEach(x=>{ %><option value="<%= x %>" <%= x===p.entry_level?'selected':'' %>><%= x %></option><% }) %></select></td>
          <td><select form="<%= formId %>" name="graduating_level" class="form-control" required><option value="">Select</option><% levels.forEach(x=>{ %><option value="<%= x %>" <%= x===p.graduating_level?'selected':'' %>><%= x %></option><% }) %></select></td>
          <td><form id="<%= formId %>" method="post" action="/staff/programmes/<%= p.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-sm btn-primary">Update</button></form></td>
        </tr>
      <% }) %>
      </tbody>
    </table></div></div>
  </div>
</section>
<script>
(function(){
  function filter(school,department){
    Array.from(department.options).forEach(function(option){ if(option.value) option.hidden=option.dataset.school!==String(school.value); });
    if(department.selectedOptions[0]&&department.selectedOptions[0].hidden) department.value='';
  }
  const newSchool=document.getElementById('newProgrammeSchool'),newDepartment=document.getElementById('newProgrammeDepartment');
  newSchool.addEventListener('change',function(){filter(newSchool,newDepartment)}); filter(newSchool,newDepartment);
  document.querySelectorAll('.programme-school').forEach(function(school){
    const department=document.querySelector('.programme-department[data-row="'+school.dataset.row+'"]');
    school.addEventListener('change',function(){filter(school,department)}); filter(school,department);
  });
})();
</script>
