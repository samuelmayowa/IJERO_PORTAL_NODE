<% const editing=(typeof editTemplate!=='undefined'&&editTemplate)?editTemplate:{}; const isEditing=Boolean(editing.id); %>
<div class="row">
<div class="col-lg-6"><div class="card modern-panel"><div class="card-header"><h3 class="card-title"><%= isEditing?'Edit document template':'Create document-template version' %></h3></div>
<form method="post" action="<%= isEditing?`/staff/admissions/documents/${editing.id}/update`:'/staff/admissions/documents' %>" enctype="multipart/form-data" id="templateForm"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><input type="hidden" name="body_html" id="bodyHtml"><input type="hidden" name="existing_watermark_image_path" value="<%= editing.watermark_image_path||'' %>"><input type="hidden" name="existing_registrar_signature_path" value="<%= editing.registrar_signature_path||'' %>"><input type="hidden" name="existing_attachment_path" value="<%= editing.attachment_path||'' %>"><div class="card-body">
<% if(isEditing&&editing.status!=='DRAFT'){ %><div class="alert alert-info">You are editing a <strong><%= editing.status.toLowerCase() %></strong> version. Saving will create a new draft revision and leave the active version unchanged.</div><% } %>
<div class="form-group"><label>Document</label><select name="document_type" class="form-control"><% [['ADMISSION_NOTIFICATION','Admission notification'],['ADMISSION_LETTER','Admission letter'],['SCREENING_SLIP','Screening slip']].forEach(o=>{ %><option value="<%= o[0] %>" <%= editing.document_type===o[0]?'selected':'' %>><%= o[1] %></option><% }) %></select></div>
<div class="form-row"><div class="form-group col-md-6"><label>Session override</label><select name="session_id" class="form-control"><option value="">Global base</option><% sessions.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(editing.session_id)===Number(s.id)?'selected':'' %>><%= s.name %></option><% }) %></select></div><div class="form-group col-md-6"><label>Application-type override</label><select name="application_form_id" class="form-control"><option value="">All types</option><% forms.forEach(f=>{ %><option value="<%= f.id %>" <%= Number(editing.application_form_id)===Number(f.id)?'selected':'' %>><%= f.title %></option><% }) %></select></div></div>
<div class="form-row"><div class="form-group col-md-6"><label>Title Line 1</label><input name="title" class="form-control" maxlength="220" value="<%= editing.title||'' %>" required></div><div class="form-group col-md-6"><label>Title Line 2 <small class="text-muted">(optional)</small></label><input name="title_line_2" class="form-control" maxlength="220" value="<%= editing.title_line_2||'' %>"></div></div>
<label>Document body</label><div class="editor-toolbar btn-toolbar border rounded-top bg-light p-2" role="toolbar"><div class="btn-group btn-group-sm mr-2"><button type="button" class="btn btn-light" data-cmd="bold"><b>B</b></button><button type="button" class="btn btn-light" data-cmd="italic"><i>I</i></button><button type="button" class="btn btn-light" data-cmd="underline"><u>U</u></button></div><div class="btn-group btn-group-sm mr-2"><button type="button" class="btn btn-light" data-cmd="justifyLeft"><i class="fas fa-align-left"></i></button><button type="button" class="btn btn-light" data-cmd="justifyCenter"><i class="fas fa-align-center"></i></button><button type="button" class="btn btn-light" data-cmd="justifyRight"><i class="fas fa-align-right"></i></button><button type="button" class="btn btn-light" data-cmd="justifyFull"><i class="fas fa-align-justify"></i></button></div><select class="form-control form-control-sm mr-2" style="width:135px" id="editorFont"><option>Arial</option><option>Georgia</option><option>Times New Roman</option><option>Verdana</option></select><select class="form-control form-control-sm mr-2" style="width:80px" id="editorSize"><option value="2">10</option><option value="3" selected>12</option><option value="4">14</option><option value="5">18</option><option value="6">24</option></select><input type="color" id="editorColor" class="form-control form-control-sm" title="Text colour" style="width:45px"></div>
<div id="richEditor" class="border border-top-0 rounded-bottom p-3" contenteditable="true" style="min-height:300px;background:#fff"><%- editing.body_html||'<p>Dear {{applicant_name}},</p><p>Enter the document content here.</p>' %></div><small class="text-muted">Placeholders: {{applicant_name}}, {{application_number}}, {{programme_name}}, {{department_name}}, {{school_name}}, {{session_name}}, {{current_date}}, {{admission_date}}, {{screening_date}}, {{screening_time}}, {{screening_venue}}.</small>
<div class="card bg-light mt-3"><div class="card-body"><h6>Watermark</h6><div class="form-row"><div class="form-group col-md-5"><label>Text watermark</label><input name="watermark_text" class="form-control" maxlength="180" value="<%= editing.watermark_text||'' %>" placeholder="e.g. EKSCOTECH"></div><div class="form-group col-md-5"><label>Image/logo watermark</label><input type="file" name="watermark_image" class="form-control-file" accept="image/png,image/jpeg"><% if(editing.watermark_image_path){ %><small class="text-success">Current image retained unless you upload a replacement.</small><% } %></div><div class="form-group col-md-2"><label>Opacity</label><input type="number" name="watermark_opacity" class="form-control" min="0.03" max="0.5" step="0.01" value="<%= editing.watermark_opacity||'0.10' %>"></div></div></div></div>
<div class="card bg-light mt-3"><div class="card-body"><h6>Registrar / Signatory</h6><div class="form-row"><div class="form-group col-md-4"><label>Full name</label><input name="registrar_name" class="form-control" maxlength="180" value="<%= editing.registrar_name||'' %>" placeholder="Registrar's full name"></div><div class="form-group col-md-4"><label>Position</label><input name="registrar_position" class="form-control" maxlength="180" value="<%= editing.registrar_position||'' %>" placeholder="Registrar"></div><div class="form-group col-md-4"><label>Signature</label><input type="file" name="registrar_signature" class="form-control-file" accept="image/png,image/jpeg"><% if(editing.registrar_signature_path){ %><small class="text-success">Current signature retained unless you upload a replacement.</small><% } %></div></div></div></div>
<div class="card border-info bg-light mt-3" id="supportingDocumentCard"><div class="card-header bg-info text-white"><h6 class="mb-0"><i class="fas fa-paperclip mr-1"></i>Upload Supporting Document</h6></div><div class="card-body"><div class="form-group mb-0"><label for="documentAttachment">Supporting document (PDF only)</label><input id="documentAttachment" type="file" name="document_attachment" class="form-control-file" accept="application/pdf,.pdf"><small class="text-muted d-block mt-1">Maximum file size: 10 MB.</small><% if(editing.attachment_path){ %><div class="mt-2"><span class="badge badge-success"><i class="fas fa-check mr-1"></i>Supporting PDF attached</span> <strong><%= editing.attachment_name||'Additional document.pdf' %></strong><br><small class="text-muted">Upload another PDF to replace it.</small></div><% }else if(isEditing){ %><div class="mt-2"><span class="badge badge-secondary">No supporting PDF attached</span></div><% } %></div></div></div></div>
<div class="card-footer d-flex flex-wrap align-items-center"><button class="btn btn-success mr-2"><%= isEditing?'Save changes':'Save draft version' %></button><button type="submit" class="btn btn-outline-primary mr-2" formaction="/staff/admissions/documents/preview-draft" formtarget="_blank"><i class="fas fa-eye mr-1"></i>Preview draft</button><button type="submit" class="btn btn-outline-danger" formaction="/staff/admissions/documents/sample-draft.pdf" formtarget="_blank"><i class="fas fa-file-pdf mr-1"></i>Download sample PDF</button><% if(isEditing){ %><a href="/staff/admissions/documents" class="btn btn-light ml-2">Cancel edit</a><% } %></div></form></div></div>
<div class="col-lg-6"><div class="card modern-panel"><div class="card-header"><h3 class="card-title">Template versions</h3></div><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Document</th><th>Scope</th><th>Version</th><th>Status</th><th>Actions</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="5" class="text-center text-muted py-4">No templates saved.</td></tr><% } rows.forEach(row=>{ %><tr><td><strong><%= row.title %></strong><% if(row.title_line_2){ %><br><strong><%= row.title_line_2 %></strong><% } %><br><small><%= row.document_type.replaceAll('_',' ') %></small><br><span class="badge badge-<%= row.attachment_path?'info':'light' %>"><i class="fas fa-<%= row.attachment_path?'paperclip':'minus' %> mr-1"></i><%= row.attachment_path?'Supporting PDF attached':'No supporting PDF' %></span></td><td><%= row.session_name||'Global' %><br><small><%= row.application_title||'All application types' %></small></td><td>v<%= row.version_no %></td><td><span class="badge badge-<%= row.status==='PUBLISHED'?'success':row.status==='DRAFT'?'warning':'secondary' %>"><%= row.status %></span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-secondary" href="/staff/admissions/documents?edit=<%= row.id %>"><i class="fas fa-edit"></i> Edit</a> <a target="_blank" class="btn btn-sm btn-outline-primary" href="/staff/admissions/documents/<%= row.id %>/preview"><i class="fas fa-eye"></i> Preview</a> <a class="btn btn-sm btn-outline-danger" href="/staff/admissions/documents/<%= row.id %>/sample.pdf"><i class="fas fa-file-pdf"></i> Sample</a> <% if(row.status==='DRAFT'){ %><form class="d-inline" method="post" action="/staff/admissions/documents/<%= row.id %>/publish"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><button class="btn btn-sm btn-success" onclick="return confirm('Publish this version and archive the previous published version for this scope?')">Publish</button></form><% } %></td></tr><% }) %></tbody></table></div></div></div>
</div>
<script>document.addEventListener('DOMContentLoaded',function(){const editor=document.getElementById('richEditor');document.querySelectorAll('[data-cmd]').forEach(b=>b.addEventListener('click',()=>{document.execCommand(b.dataset.cmd,false,null);editor.focus()}));document.getElementById('editorFont').addEventListener('change',e=>document.execCommand('fontName',false,e.target.value));document.getElementById('editorSize').addEventListener('change',e=>document.execCommand('fontSize',false,e.target.value));document.getElementById('editorColor').addEventListener('input',e=>document.execCommand('foreColor',false,e.target.value));document.getElementById('templateForm').addEventListener('submit',()=>document.getElementById('bodyHtml').value=editor.innerHTML)});</script>
