<!doctype html>
<html><head><meta charset="utf-8"><title>Document Preview</title><style>
@page{size:A4;margin:16mm}body{margin:0;background:#eef1f5;font-family:Arial,sans-serif;color:#222}.actions{position:sticky;top:0;background:#172033;color:#fff;padding:12px;text-align:center;z-index:3}.actions button{padding:8px 18px}.page{box-sizing:border-box;position:relative;width:210mm;min-height:297mm;margin:24px auto;background:#fff;padding:16mm;box-shadow:0 12px 40px #9aa3ad;overflow:hidden;page-break-after:always}.head{text-align:center;border-bottom:2px solid #82103c;padding:0 28mm 15px;position:relative;z-index:2}.head>.school-logo{width:62px;position:absolute;left:0;top:0}.head h1{font-size:20px;color:#247d57;margin:0 0 5px}.head p{margin:3px}.passport{position:absolute;right:16mm;top:16mm;width:78px;height:92px;object-fit:cover;border:1px solid #ccd2d8;z-index:3}.printed-at{position:absolute;right:16mm;top:5mm;font-size:8px;color:#555;z-index:4}.title{text-align:center;color:#82103c;margin:24px 0 6px;position:relative;z-index:2}.title.second{margin:0 0 24px}.body{line-height:1.65;position:relative;z-index:2}.watermark-text{position:absolute;inset:42% 0 auto;transform:rotate(-35deg);font-size:64px;text-align:center;font-weight:bold;color:#777;pointer-events:none}.watermark-grid{position:absolute;inset:115px 28px 65px;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);align-items:center;justify-items:center;pointer-events:none}.watermark-grid img{width:95px;max-height:105px;object-fit:contain}.personal-watermarks{position:absolute;inset:165px -55px 65px;display:flex;flex-direction:column;justify-content:space-around;pointer-events:none;transform:rotate(-24deg);color:#d71920;font-size:18px;font-weight:700;opacity:.11;text-align:center;white-space:nowrap}.sample-qr{position:absolute;right:16mm;bottom:10mm;width:60px;text-align:center;z-index:3;font-size:9px;color:#555}.sample-qr img{width:60px;display:block;margin-bottom:3px}.attachment-page{padding:0}.attachment-page object{width:100%;height:297mm;border:0}@media print{body{background:#fff}.actions{display:none}.page{box-shadow:none;margin:0;width:210mm;min-height:297mm;padding:16mm}.attachment-page{padding:0}}
</style></head><body>
<div class="actions"><button onclick="window.print()">Print / Save as PDF</button></div>
<main class="page">
  <% if(template.watermark_text){ %><div class="watermark-text" style="opacity:<%= template.watermark_opacity %>"><%= template.watermark_text %></div><% } %>
  <% if(template.watermark_image_path){ %><div class="watermark-grid" style="opacity:<%= template.watermark_opacity %>"><% for(let i=0;i<9;i++){ %><img src="<%= template.watermark_image_path %>" alt=""><% } %></div><% } %>
  <% if(template.personal_watermark){ %><div class="personal-watermarks"><% for(let i=0;i<4;i++){ %><div><%= template.personal_watermark %></div><% } %></div><% } %>
  <div class="printed-at">Printed: <%= template.printed_at||new Date().toLocaleString('en-GB') %></div><% if(template.passport_path){ %><img class="passport" src="<%= template.passport_path %>" alt="Applicant passport"><% } %>
  <header class="head"><img class="school-logo" src="/public/img/logo.png"><h1>EKITI STATE COLLEGE OF TECHNOLOGY</h1><p>IJERO-EKITI, EKITI STATE</p><p>P.M.B. 316, Epe Ara Road, Ijero-Ekiti, Ekiti State</p><div style="clear:both"></div></header>
  <h2 class="title"><%= template.title %></h2><% if(template.title_line_2){ %><h2 class="title second"><%= template.title_line_2 %></h2><% } %><section class="body"><%- template.body_html %></section>
  <% if(template.registrar_signature_path||template.registrar_name||template.registrar_position){ %><div style="position:relative;z-index:2;margin-top:45px;width:260px"><% if(template.registrar_signature_path){ %><img src="<%= template.registrar_signature_path %>" alt="Registrar signature" style="display:block;max-width:145px;max-height:58px;object-fit:contain"><% } %><strong><%= template.registrar_name||'Registrar' %></strong><br><span><%= template.registrar_position||'Registrar' %></span></div><% } %>
  <% if(template.qr_data_url && ['ADMISSION_NOTIFICATION','ADMISSION_LETTER','SCREENING_SLIP'].includes(template.document_type)){ %><div class="sample-qr"><img src="<%= template.qr_data_url %>" alt="Verification code">Verification Code</div><% } %>
</main><% if(template.attachment_path){ %><section class="page attachment-page"><object data="<%= template.attachment_path %>" type="application/pdf"><p>Additional PDF attachment: <%= template.attachment_name||'Open document' %></p></object><div class="printed-at">Printed: <%= template.printed_at||new Date().toLocaleString('en-GB') %></div><% if(template.qr_data_url){ %><div class="sample-qr"><img src="<%= template.qr_data_url %>" alt="Verification code">Verification Code</div><% } %></section><% } %></body></html>
