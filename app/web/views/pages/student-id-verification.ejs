<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><style>
:root{--green:#086b4c;--ink:#102a22;--muted:#63736d;--line:#d7e4df;--red:#b42318;--brown:#6f3f20}*{box-sizing:border-box}body{margin:0;background:#eef5f2;color:var(--ink);font-family:Arial,sans-serif}.shell{min-height:100vh;display:grid;place-items:center;padding:24px}.card{position:relative;width:min(760px,100%);background:#fff;border:1px solid var(--line);border-radius:22px;overflow:hidden;box-shadow:0 24px 70px rgba(16,42,34,.16)}.card>*{position:relative;z-index:2}.head{padding:24px;background:linear-gradient(135deg,#064c38,#0b8060);color:#fff;display:flex;align-items:center;gap:16px}.logo{width:72px;height:72px;object-fit:contain;background:#fff;border-radius:50%;padding:7px}.head h1{font-size:22px;margin:0 0 4px}.head p{margin:0;opacity:.85}.body{padding:28px;background:rgba(255,255,255,.88)}.verified{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:24px;padding:13px 16px;border-radius:12px;background:#edf9f4;color:#086b4c;font-weight:700}.verified.inactive{background:#fff1f0;color:var(--red)}.identity{display:grid;grid-template-columns:160px 1fr;gap:28px}.passport{width:160px;height:190px;object-fit:cover;border:1px solid var(--line);border-radius:12px;background:#f4f4f4}.name{font-size:27px;margin:0 0 18px}.details{display:grid;grid-template-columns:150px 1fr;gap:10px 18px}.label{color:var(--muted);font-size:13px;text-transform:uppercase;letter-spacing:.04em}.value{font-weight:700}.note{border-top:1px solid var(--line);margin-top:28px;padding-top:18px;color:var(--muted);font-size:13px}.ict-footer{padding:13px 20px;text-align:center;background:var(--brown);color:#fff;font-size:13px;font-weight:700;letter-spacing:.035em}.watermarks{position:absolute;z-index:1;inset:105px 0 42px;overflow:hidden;pointer-events:none;opacity:.06;display:grid;grid-template-columns:repeat(3,1fr);align-content:space-around;transform:rotate(-18deg) scale(1.1)}.watermark{display:flex;align-items:center;gap:8px;white-space:nowrap;font-weight:800;font-size:13px;padding:8px}.watermark img{width:28px;height:28px;object-fit:contain}.missing{text-align:center;padding:48px 28px}.missing h1{color:var(--red)}@media(max-width:600px){.identity{grid-template-columns:1fr}.passport{margin:auto}.details{grid-template-columns:1fr;gap:4px}.value{margin-bottom:10px}.head{align-items:flex-start}.logo{width:54px;height:54px}.watermarks{grid-template-columns:repeat(2,1fr)}}
</style></head><body><main class="shell"><section class="card">
<% if(!student){ %><div class="missing"><h1>Student ID not verified</h1><p>This verification code is invalid or is no longer available.</p></div>
<% } else { %>
<div class="watermarks" aria-hidden="true"><% for(let i=0;i<9;i+=1){ %><div class="watermark"><img src="/public/img/logo.png" alt=""><span><%= student.full_name %> · <%= student.matric_number||'NO MATRIC' %></span></div><% } %></div><header class="head"><img class="logo" src="/public/img/logo.png" alt="College logo"><div><h1><%= schoolName %></h1><p><%= schoolAddress %></p></div></header><div class="body"><div class="verified <%= student.card_status==='ACTIVE'?'':'inactive' %>"><span>Official student identity record</span><span><%= student.card_status %></span></div><div class="identity"><img class="passport" src="<%= photoUrl %>" alt="Passport photograph of <%= student.full_name %>"><div><h2 class="name"><%= student.full_name %></h2><div class="details"><div class="label">Matric number</div><div class="value"><%= student.matric_number||'Not recorded' %></div><div class="label">School</div><div class="value"><%= student.school %></div><div class="label">Department</div><div class="value"><%= student.department %></div><div class="label">Programme</div><div class="value"><%= student.programme %></div><div class="label">Level</div><div class="value"><%= student.level %></div><div class="label">Year of entry</div><div class="value"><%= student.year_of_entry %></div></div></div></div><p class="note">This page is the live verification record for the QR code printed on the student's identification card.</p></div><footer class="ict-footer">Powered by Directorate of ICT</footer><% } %>
</section></main></body></html>
