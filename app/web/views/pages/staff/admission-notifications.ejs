<div class="card card-outline card-success"><div class="card-header"><h3 class="card-title">Admission email deliveries</h3></div><div class="card-body table-responsive p-0"><table class="table table-hover table-sm"><thead><tr><th>Applicant</th><th>Notification</th><th>Recipient</th><th>Status</th><th>Attempts</th><th>Last error</th><th></th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="7" class="text-center text-muted py-4">No email deliveries have been queued.</td></tr><% } %><% rows.forEach(row=>{ %><tr><td><%= row.first_name %> <%= row.last_name %><br><small><%= row.application_number||'' %></small></td><td><%= row.title %><br><small><%= row.notification_type %></small></td><td><%= row.recipient %></td><td><span class="badge badge-<%= row.status==='SENT'?'success':row.status==='FAILED'?'danger':'warning' %>"><%= row.status %></span></td><td><%= row.attempts %></td><td><small><%= row.last_error||'—' %></small></td><td><% if(row.status!=='SENT'){ %><form method="post" action="/staff/admissions/notifications/<%= row.id %>/resend"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><button class="btn btn-sm btn-outline-primary">Retry</button></form><% } %></td></tr><% }) %></tbody></table></div></div>
