<% const generated=rows.filter(x=>x.matric_number).length, ready=rows.filter(x=>x.generation_ready).length, acceptanceOnly=rows.filter(x=>x.lifecycle_status==='AWAITING_ADMISSION').length; %>
<div class="row modern-metrics"><div class="col-lg-3 col-6"><div class="metric-card accent-blue" data-icon="&#xf2c2;"><span>Generated</span><strong><%= generated %></strong><small>Selected session</small></div></div><div class="col-lg-3 col-6"><div class="metric-card accent-success" data-icon="&#xf058;"><span>Ready</span><strong><%= ready %></strong><small>Eligible for generation</small></div></div><div class="col-lg-3 col-6"><div class="metric-card accent-amber" data-icon="&#xf09d;"><span>Acceptance paid</span><strong><%= acceptanceOnly %></strong><small>Not yet admitted</small></div></div><div class="col-lg-3 col-6"><div class="metric-card accent-violet" data-icon="&#xf292;"><span>Last sequence</span><strong><%= String(sequence.last_number||0).padStart(3,'0') %></strong><small>Institution-wide counter</small></div></div></div>
<div class="card modern-panel"><div class="card-header d-flex align-items-center"><h3 class="card-title"><i class="fas fa-id-card text-success mr-2"></i>Matriculation lifecycle queue</h3><form method="get" class="ml-auto"><select name="session_id" class="form-control form-control-sm" onchange="this.form.submit()"><% sessions.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(sessionId)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></form></div><form method="post" action="/staff/admissions/matriculation/bulk"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="card-body p-0 table-responsive"><table class="table table-hover mb-0"><thead><tr><th><input type="checkbox" onclick="document.querySelectorAll('.matric-check').forEach(x=>x.checked=this.checked)"></th><th>Applicant</th><th>Department / Programme</th><th>Acceptance</th><th>Lifecycle status</th><th>Matriculation number</th><th></th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="7" class="text-center text-muted py-5">No acceptance-paid applicants or student transitions exist for this session.</td></tr><% } rows.forEach(x=>{ const tone=x.lifecycle_status==='GENERATED'||x.lifecycle_status==='READY_TO_GENERATE'?'cleared':x.lifecycle_status==='AWAITING_ADMISSION'?'creditor':'debtor'; %><tr><td><% if(x.generation_ready){ %><input class="matric-check" type="checkbox" name="application_ids" value="<%= x.applicant_application_id %>"><% } %></td><td><strong><%= [x.first_name,x.middle_name,x.last_name].filter(Boolean).join(' ') %></strong><br><small><%= x.application_number %></small></td><td><%= x.department_name||'Not offered yet' %> <% if(x.department_code){ %><span class="badge badge-light"><%= x.department_code %></span><% } %><br><small><%= x.programme_name||x.offered_programme_name||'Awaiting admission decision' %></small></td><td><span class="badge badge-success"><%= x.acceptance_payment_status %></span></td><td><span class="status-pill status-<%= tone %>"><%= x.lifecycle_status.replaceAll('_',' ') %></span><% if(x.lifecycle_status==='AWAITING_ADMISSION'){ %><br><small class="text-muted">Admission must be issued first.</small><% } else if(x.lifecycle_status==='AWAITING_COMPULSORY_FEE'){ %><br><small class="text-muted">Waiting for confirmed compulsory fee.</small><% } %></td><td><strong><%= x.matric_number||'—' %></strong><% if(x.sequence_number){ %><br><small>Session sequence <%= String(x.sequence_number).padStart(3,'0') %></small><% } %></td><td><% if(x.generation_ready){ %><button formaction="/staff/admissions/matriculation/<%= x.applicant_application_id %>/generate" class="btn btn-sm btn-outline-primary">Generate</button><% } else if(x.lifecycle_status==='AWAITING_ADMISSION'){ %><a class="btn btn-sm btn-outline-success" href="/staff/admissions/manage?q=<%= encodeURIComponent(x.application_number) %>">Review admission</a><% } %></td></tr><% }) %></tbody></table></div><div class="card-footer"><button class="btn btn-primary" <%= ready?'':'disabled' %>><i class="fas fa-cogs mr-1"></i>Generate selected</button><span class="text-muted ml-2">Only admitted applicants with both required payments can be generated.</span></div></form></div>
