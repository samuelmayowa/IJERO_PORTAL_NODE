<% const sittings=Array.isArray(olevel?.sittings)?olevel.sittings:[]; const subjectFields=[['english_language','English Language'],['mathematics','Mathematics'],['biology','Biology'],['physics','Physics'],['chemistry','Chemistry'],['economics','Economics'],['agricultural_science','Agricultural Science'],['geography','Geography'],['civic_education','Civic Education']]; const grades=['','A1','B2','B3','C4','C5','C6','D7','E8','F9']; %>
<div class="row"><div class="col-lg-8">
<div class="card card-outline card-success"><div class="card-header"><h3 class="card-title">Correct applicant record</h3></div>
<form method="post" action="/staff/admissions/applicants/<%= application.id %>/edit"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="card-body">
<div class="alert alert-info"><strong><%= application.application_number %></strong> · <%= application.application_title %> · <%= application.session_name %><br>This changes the Applicant record only. It does not alter a Student record.</div>
<h5>Personal details</h5><div class="form-row"><div class="form-group col-md-4"><label>First name</label><input name="first_name" class="form-control" value="<%= application.first_name %>" required></div><div class="form-group col-md-4"><label>Middle name</label><input name="middle_name" class="form-control" value="<%= application.middle_name||'' %>"></div><div class="form-group col-md-4"><label>Surname</label><input name="last_name" class="form-control" value="<%= application.last_name %>" required></div></div>
<div class="form-row"><div class="form-group col-md-6"><label>Email/login</label><input type="email" name="email" class="form-control" value="<%= application.username||'' %>" required></div><div class="form-group col-md-3"><label>Phone</label><input name="phone" class="form-control" value="<%= application.phone||'' %>"></div><div class="form-group col-md-3"><label>Date of birth</label><input type="date" name="dob" class="form-control" value="<%= application.dob?new Date(application.dob).toISOString().slice(0,10):'' %>"></div></div>
<div class="form-row"><div class="form-group col-md-3"><label>Gender</label><select name="gender" class="form-control"><option value="">Select</option><% ['Male','Female'].forEach(x=>{ %><option <%= String(application.gender||'').toLowerCase()===x.toLowerCase()?'selected':'' %>><%= x %></option><% }) %></select></div><div class="form-group col-md-3"><label>State of origin</label><input name="state_of_origin" class="form-control" value="<%= application.state_of_origin||'' %>"></div><div class="form-group col-md-3"><label>LGA</label><input name="lga" class="form-control" value="<%= application.lga||'' %>"></div><div class="form-group col-md-3"><label>Address</label><input name="address" class="form-control" value="<%= application.address||'' %>"></div></div>
<h5 class="mt-3">Academic placement</h5><div class="form-row"><div class="form-group col-md-4"><label>School</label><select id="editSchool" name="school_id" class="form-control" required><option value="">Select</option><% schools.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(choice.school_id)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div><div class="form-group col-md-4"><label>Department</label><select id="editDepartment" name="department_id" class="form-control" required><option value="">Select</option><% departments.forEach(x=>{ %><option value="<%= x.id %>" data-school="<%= x.school_id %>" <%= Number(choice.department_id)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div><div class="form-group col-md-4"><label>Programme</label><select id="editProgramme" name="programme_id" class="form-control" required><option value="">Select</option><% programmes.forEach(x=>{ %><option value="<%= x.id %>" data-school="<%= x.school_id %>" data-department="<%= x.department_id %>" <%= Number(choice.programme_id)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div></div>
<h5 class="mt-3">O'Level results</h5><div class="form-group col-md-4 px-0"><label>Number of sittings</label><select id="sittingCount" name="olevel_sitting_count" class="form-control"><option value="1" <%= Number(olevel?.sitting_count||1)===1?'selected':'' %>>One</option><option value="2" <%= Number(olevel?.sitting_count)===2?'selected':'' %>>Two</option></select></div>
<% [1,2].forEach(number=>{const sitting=sittings[number-1]||{},results=sitting.subjects||{}; %><div class="card bg-light olevel-sitting" data-sitting="<%= number %>"><div class="card-header"><strong>Sitting <%= number %></strong></div><div class="card-body"><div class="form-row"><div class="form-group col-md-4"><label>Exam type</label><input name="sitting_<%= number %>_exam_type" value="<%= sitting.examination_type||'' %>" class="form-control" placeholder="WAEC, NECO or NABTEB"></div><div class="form-group col-md-4"><label>Exam number</label><input name="sitting_<%= number %>_exam_number" value="<%= sitting.examination_number||'' %>" class="form-control"></div><div class="form-group col-md-4"><label>Exam year</label><input name="sitting_<%= number %>_exam_year" value="<%= sitting.examination_year||'' %>" class="form-control" maxlength="4"></div></div><div class="form-row"><% subjectFields.forEach(([key,label])=>{ %><div class="form-group col-md-4"><label><%= label %></label><select name="sitting_<%= number %>_<%= key %>" class="form-control"><% grades.forEach(grade=>{ %><option value="<%= grade %>" <%= String(results[key]||'').toUpperCase()===grade?'selected':'' %>><%= grade||'Not entered' %></option><% }) %></select></div><% }) %></div></div></div><% }) %>
<div class="form-group"><label>Reason for correction</label><textarea name="reason" class="form-control" required placeholder="Explain why this record is being corrected."></textarea></div></div><div class="card-footer"><button class="btn btn-success">Save correction</button> <a href="/staff/admissions/manage" class="btn btn-secondary">Back</a></div></form></div>
<div class="card"><div class="card-header"><h3 class="card-title">Replace passport photograph</h3></div><form method="post" enctype="multipart/form-data" action="/staff/admissions/applicants/<%= application.id %>/passport/passport"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="card-body"><p>Current: <%= documents[0]?.original_filename||'No passport uploaded' %></p><input type="file" name="document" class="form-control-file" accept="image/jpeg,image/png" required><div class="form-group mt-3"><label>Reason for replacement</label><textarea name="reason" class="form-control" required></textarea></div><small class="text-muted">JPG or PNG only, maximum 5 MB.</small></div><div class="card-footer"><button class="btn btn-primary">Replace passport</button></div></form></div>
</div><div class="col-lg-4"><div class="card"><div class="card-header"><h3 class="card-title">Correction history</h3></div><div class="card-body p-0"><div class="list-group list-group-flush"><% if(!audits.length){ %><div class="p-3 text-muted">No corrections recorded.</div><% } %><% audits.forEach(a=>{ %><div class="list-group-item"><strong><%= a.action.replaceAll('_',' ') %></strong><small class="float-right"><%= new Date(a.created_at).toLocaleString('en-GB') %></small><% if(a.reason){ %><p class="mb-0 mt-2"><%= a.reason %></p><% } %><small class="text-muted">By <%= a.actor_role||'system' %></small></div><% }) %></div></div></div></div></div>
<script>document.addEventListener('DOMContentLoaded',function(){var s=document.getElementById('editSchool'),d=document.getElementById('editDepartment'),p=document.getElementById('editProgramme'),count=document.getElementById('sittingCount');function filter(){Array.from(d.options).forEach(o=>o.hidden=!!o.value&&!!s.value&&o.dataset.school!==s.value);Array.from(p.options).forEach(o=>o.hidden=!!o.value&&((s.value&&o.dataset.school!==s.value)||(d.value&&o.dataset.department!==d.value)))}function showSittings(){document.querySelectorAll('.olevel-sitting').forEach(x=>x.hidden=Number(x.dataset.sitting)>Number(count.value))}s.addEventListener('change',()=>{d.value='';p.value='';filter()});d.addEventListener('change',()=>{p.value='';filter()});count.addEventListener('change',showSittings);filter();showSittings()});</script>
