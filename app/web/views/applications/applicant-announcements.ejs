<div class="row"><div class="col-lg-9 mx-auto"><% if(!announcements.length){ %><div class="card modern-panel"><div class="card-body text-center py-5"><i class="far fa-bell-slash fa-3x text-muted mb-3"></i><h5>No active announcements</h5><p class="text-muted mb-0">New notices relevant to your application will appear here.</p></div></div><% } announcements.forEach(item=>{ const tone=item.priority==='URGENT'?'danger':item.priority==='IMPORTANT'?'warning':'success'; %><article class="card modern-panel border-left border-<%= tone %>"><div class="card-body"><div class="d-flex align-items-start"><div class="mr-3 text-<%= tone %>"><i class="fas fa-<%= item.priority==='URGENT'?'exclamation-triangle':'bullhorn' %> fa-2x"></i></div><div class="flex-grow-1"><div class="d-flex justify-content-between"><h4><%= item.title %></h4><span class="badge badge-<%= tone %>"><%= item.priority %></span></div><p class="mb-2"><%= item.body %></p><small class="text-muted">Published <%= new Date(item.publish_at).toLocaleString('en-GB') %></small></div></div></div></article><% }) %></div></div>
