<div class="finance-report">
  <% const reportParams={fee_category:filters.feeCategory,session_id:filters.sessionId||'',school_id:filters.schoolId||'',department_id:filters.departmentId||'',programme_id:filters.programmeId||'',q:filters.q||'',per_page:pagination.perPage}; const cardExport=metric=>'/staff/fees/debtors-creditors/export/xlsx?'+new URLSearchParams({...reportParams,metric}).toString(); %>
  <style>.finance-report .metric-card{padding-bottom:48px}.finance-report .metric-export{position:absolute;left:20px;bottom:14px;border-color:var(--metric);color:var(--metric);font-weight:700;background:#fff;z-index:2}.finance-report .metric-export:hover{background:var(--metric);color:#fff}</style>
  <div class="alert alert-light border"><i class="fas fa-info-circle mr-1"></i>The balances below are calculated for <strong><%= categoryLabel %> only</strong>. Acceptance and compulsory fees are shown separately. Please use the Fee report dropdown below to filter the report.</div>
  <div class="row modern-metrics">
    <div class="col-lg-3 col-6"><div class="metric-card accent-danger" data-icon="&#xf071;"><span>Debtors</span><strong><%= summary.debtors %></strong><small>Students with outstanding balances</small><a class="btn btn-xs metric-export" href="<%= cardExport('DEBTORS') %>"><i class="fas fa-download mr-1"></i>Export</a></div></div>
    <div class="col-lg-3 col-6"><div class="metric-card accent-amber" data-icon="&#xf53a;"><span>Total outstanding</span><strong>₦<%= Number(summary.totalDebt).toLocaleString() %></strong><small>Confirmed session obligation</small><a class="btn btn-xs metric-export" href="<%= cardExport('OUTSTANDING') %>"><i class="fas fa-download mr-1"></i>Export</a></div></div>
    <div class="col-lg-3 col-6"><div class="metric-card accent-blue" data-icon="&#xf4c0;"><span>Creditors</span><strong><%= summary.creditors %></strong><small>Students with credit balances</small><a class="btn btn-xs metric-export" href="<%= cardExport('CREDITORS') %>"><i class="fas fa-download mr-1"></i>Export</a></div></div>
    <div class="col-lg-3 col-6"><div class="metric-card accent-violet" data-icon="&#xf555;"><span>Total credit</span><strong>₦<%= Number(summary.totalCredit).toLocaleString() %></strong><small>For Bursary review</small><a class="btn btn-xs metric-export" href="<%= cardExport('CREDIT') %>"><i class="fas fa-download mr-1"></i>Export</a></div></div>
    <div class="col-lg-3 col-6"><div class="metric-card accent-success" data-icon="&#xf058;"><span>Successful payments</span><strong><%= Number(summary.successfulTransactions).toLocaleString() %></strong><small>₦<%= Number(summary.successfulAmount).toLocaleString() %> received</small><a class="btn btn-xs metric-export" href="<%= cardExport('SUCCESSFUL_PAYMENTS') %>"><i class="fas fa-download mr-1"></i>Export</a></div></div>
    <div class="col-lg-3 col-6"><div class="metric-card accent-blue" data-icon="&#xf501;"><span>Students who paid</span><strong><%= Number(summary.successfulStudents).toLocaleString() %></strong><small>Successful transactions for <%= sessionName %></small><a class="btn btn-xs metric-export" href="<%= cardExport('SUCCESSFUL_STUDENTS') %>"><i class="fas fa-download mr-1"></i>Export</a></div></div>
    <div class="col-lg-3 col-6"><div class="metric-card accent-amber" data-icon="&#xf080;"><span>Expected vs paid</span><strong>₦<%= Number(summary.totalExpected).toLocaleString() %></strong><small>Paid: ₦<%= Number(summary.totalPaid).toLocaleString() %> · <%= sessionName %></small><a class="btn btn-xs metric-export" href="<%= cardExport('EXPECTED_PAID') %>"><i class="fas fa-download mr-1"></i>Export</a></div></div>
    <div class="col-lg-3 col-6"><div class="metric-card accent-danger" data-icon="&#xf53d;"><span>Debt after adjustment</span><strong>₦<%= Number(summary.adjustedDebt).toLocaleString() %></strong><small>Outstanding less overpayments</small><a class="btn btn-xs metric-export" href="<%= cardExport('ADJUSTED_DEBT') %>"><i class="fas fa-download mr-1"></i>Export</a></div></div>
  </div>
  <div class="card modern-panel"><div class="card-body"><form method="get" class="form-row">
    <div class="form-group col-md-3 col-lg-2"><label>Fee report</label><select name="fee_category" class="form-control"><option value="SCHOOL_FEE" <%= filters.feeCategory==='SCHOOL_FEE'?'selected':'' %>>School Fee</option><option value="ACCEPTANCE" <%= filters.feeCategory==='ACCEPTANCE'?'selected':'' %>>Acceptance Fee</option><option value="COMPULSORY" <%= filters.feeCategory==='COMPULSORY'?'selected':'' %>>Compulsory Fee</option></select></div>
    <div class="form-group col-md-3 col-lg-2"><label>Session</label><select name="session_id" class="form-control"><% sessions.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(filters.sessionId)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div>
    <div class="form-group col-md-3 col-lg-2"><label>School</label><select name="school_id" id="balanceSchool" class="form-control"><option value="">All schools</option><% schools.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(filters.schoolId)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div>
    <div class="form-group col-md-3 col-lg-2"><label>Department</label><select name="department_id" id="balanceDepartment" class="form-control"><option value="">All departments</option><% departments.forEach(x=>{ %><option value="<%= x.id %>" data-school="<%= x.school_id %>" <%= Number(filters.departmentId)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div>
    <div class="form-group col-md-3 col-lg-2"><label>Programme</label><select name="programme_id" id="balanceProgramme" class="form-control"><option value="">All programmes</option><% programmes.forEach(x=>{ %><option value="<%= x.id %>" data-school="<%= x.school_id %>" data-department="<%= x.department_id %>" <%= Number(filters.programmeId)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div>
    <div class="form-group col-md-7 col-lg-2"><label>Search</label><input class="form-control" name="q" value="<%= filters.q %>" placeholder="Name, matric or email"></div><div class="form-group col-md-2 d-flex align-items-end"><button class="btn btn-primary btn-block">Apply</button></div>
  </form><div class="d-flex flex-wrap align-items-center"><span class="badge badge-light border mr-2 px-3 py-2"><%= categoryLabel %></span><a class="btn btn-sm btn-outline-success mr-2 <%= selectedType==='DEBTOR'?'active':'' %>" href="?<%= new URLSearchParams({...reportParams,type:'DEBTOR'}).toString() %>">View Debtors</a><a class="btn btn-sm btn-success mr-2" href="/staff/fees/debtors-creditors/export/xlsx?<%= new URLSearchParams({...reportParams,type:'DEBTOR'}).toString() %>"><i class="fas fa-file-excel mr-1"></i>Export Debtors</a><a class="btn btn-sm btn-outline-primary mr-2 <%= selectedType==='CREDITOR'?'active':'' %>" href="?<%= new URLSearchParams({...reportParams,type:'CREDITOR'}).toString() %>">View Creditors</a><a class="btn btn-sm btn-primary mr-auto" href="/staff/fees/debtors-creditors/export/xlsx?<%= new URLSearchParams({...reportParams,type:'CREDITOR'}).toString() %>"><i class="fas fa-file-excel mr-1"></i>Export Creditors</a><% ['csv','xlsx','pdf'].forEach(f=>{ %><a class="btn btn-sm btn-light ml-2" href="/staff/fees/debtors-creditors/export/<%= f %>?<%= new URLSearchParams({...reportParams,type:selectedType}).toString() %>"><%= f.toUpperCase() %></a><% }) %></div></div></div>
  <div class="card modern-panel"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th><%= filters.feeCategory==='SCHOOL_FEE'?'Student':'Applicant' %></th><th>School / Department</th><th>Programme</th><th class="text-right">Expected</th><th class="text-right">Paid</th><th class="text-right">Balance</th><th>Status</th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="7" class="text-center text-muted py-5">No matching <%= categoryLabel.toLowerCase() %> balances were found.</td></tr><% } rows.forEach(x=>{ %><tr><td><strong><%= x.full_name %></strong><br><small><%= x.matric_number||x.email %></small></td><td><%= x.school_name||'-' %><br><small><%= x.department_name||'-' %></small></td><td><%= x.programme_name||'-' %></td><td class="text-right">₦<%= Number(x.expected).toLocaleString() %></td><td class="text-right">₦<%= Number(x.paid).toLocaleString() %><% if(filters.feeCategory==='SCHOOL_FEE'&&Number(x.legacy_paid)>0){ %><br><small class="text-muted">Old portal: ₦<%= Number(x.legacy_paid).toLocaleString() %></small><% } %></td><td class="text-right font-weight-bold">₦<%= Math.abs(Number(x.balance)).toLocaleString() %></td><td><span class="status-pill status-<%= x.status.toLowerCase() %>"><%= x.status %></span></td></tr><% }) %></tbody></table></div><div class="card-footer d-flex flex-wrap align-items-center"><span class="text-muted mr-auto">Showing <%= pagination.from %>–<%= pagination.to %> of <%= pagination.totalRows.toLocaleString() %></span><form method="get" class="form-inline mr-3"><% Object.entries(reportParams).forEach(([key,value])=>{ if(key!=='per_page'){ %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }}); if(selectedType){ %><input type="hidden" name="type" value="<%= selectedType %>"><% } %><label class="mr-2" for="balancePageSize">Rows</label><select id="balancePageSize" name="per_page" class="form-control form-control-sm" onchange="this.form.submit()"><% pagination.allowedSizes.forEach(size=>{ %><option value="<%= size %>" <%= pagination.perPage===size?'selected':'' %>><%= size %></option><% }) %></select></form><nav aria-label="Balance report pages"><ul class="pagination pagination-sm mb-0"><% const pageLink=n=>'?'+new URLSearchParams({...reportParams,type:selectedType,page:n}).toString(); %><li class="page-item <%= pagination.currentPage===1?'disabled':'' %>"><a class="page-link" href="<%= pageLink(Math.max(1,pagination.currentPage-1)) %>">Previous</a></li><% const first=Math.max(1,pagination.currentPage-2),last=Math.min(pagination.totalPages,first+4); for(let n=Math.max(1,last-4);n<=last;n++){ %><li class="page-item <%= n===pagination.currentPage?'active':'' %>"><a class="page-link" href="<%= pageLink(n) %>"><%= n %></a></li><% } %><li class="page-item <%= pagination.currentPage===pagination.totalPages?'disabled':'' %>"><a class="page-link" href="<%= pageLink(Math.min(pagination.totalPages,pagination.currentPage+1)) %>">Next</a></li></ul></nav></div></div>
  <% if (!obligationCount) { %><div class="alert alert-warning border"><i class="fas fa-exclamation-triangle mr-1"></i>No <%= categoryLabel.toLowerCase() %> obligation applies to the selected session and filters. Please check the fee configuration and its school, department, programme and level assignments.</div><% } %>
</div>
