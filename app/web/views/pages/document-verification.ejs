<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Document Verification</title><style>
:root{--green:#247d57;--wine:#82103c;--ink:#18242f}*{box-sizing:border-box}body{margin:0;background:linear-gradient(145deg,#edf6f1,#f7f9fb);font-family:Arial,sans-serif;color:var(--ink)}main{width:min(760px,calc(100% - 28px));margin:0 auto;padding:34px 0}.card{background:#fff;border:1px solid #dfe7e3;border-radius:18px;box-shadow:0 18px 50px rgba(22,70,50,.13);overflow:hidden}.head{padding:26px 28px;text-align:center;background:linear-gradient(145deg,#f8fcfa,#e8f4ed);border-bottom:1px solid #dce9e2}.logo{width:78px;height:auto}.head h1{font-size:clamp(1.35rem,4vw,2rem);margin:12px 0 4px;color:var(--green)}.head p{margin:0;color:#65736c}.body{padding:28px}.status{padding:16px;border-radius:12px;text-align:center;margin-bottom:24px}.status h2{margin:0 0 5px;font-size:1.25rem}.status p{margin:0}.valid{background:#e8f7ef;color:#16623f;border:1px solid #bfe6d1}.invalid{background:#fff0f1;color:#a52334;border:1px solid #f0c5ca}.sample{background:#fff7df;color:#765b09;border:1px solid #efd783}.details{display:grid;grid-template-columns:minmax(150px,.8fr) minmax(0,1.4fr);border:1px solid #e2e8e5;border-radius:12px;overflow:hidden}.label,.value{padding:12px 15px;border-bottom:1px solid #e8ecea}.label{font-weight:700;background:#f6f9f7}.value{overflow-wrap:anywhere}.details>*:nth-last-child(-n+2){border-bottom:0}.foot{text-align:center;color:#68756f;font-size:.83rem;margin-top:20px}@media(max-width:560px){main{width:min(100% - 18px,760px);padding:12px 0}.card{border-radius:13px}.head{padding:20px 16px}.logo{width:64px}.body{padding:16px}.details{grid-template-columns:1fr}.label{padding:10px 12px 3px;border-bottom:0;color:#52625a;font-size:.78rem;text-transform:uppercase;letter-spacing:.04em}.value{padding:2px 12px 11px}.details>*:nth-last-child(-n+2){border-bottom:initial}.details .value:last-child{border-bottom:0}}
</style></head><body><main><section class="card"><header class="head"><img class="logo" src="/public/img/logo.png" alt="Ekiti State College of Technology logo"><h1>Document Verification</h1><p>Ekiti State College of Technology, Ijero-Ekiti</p></header><div class="body">
<% if(!document){ %><div class="status invalid"><h2>Document not verified</h2><p>The verification code is invalid or the document is not in the College's issued-document register.</p></div><p class="foot">Please contact the Registry if you believe this result is incorrect.</p>
<% } else { const sampleMode=Boolean(typeof isSample!=='undefined'&&isSample); const valid=!sampleMode&&document.status==='VALID'; const purpose=String(document.document_type||'').replaceAll('_',' '); const fullName=[document.first_name,document.middle_name,document.last_name].filter(Boolean).join(' '); %>
<div class="status <%= sampleMode?'sample':valid?'valid':'invalid' %>"><h2><%= sampleMode?'Sample document — not genuine':valid?'Genuine College document':'Document is no longer valid' %></h2><p><%= sampleMode?'This page demonstrates the information returned by a verification scan.':valid?'The verification code matches a valid document in the College register.':`The document status is ${document.status}. Please contact the Registry.` %></p></div>
<div class="details"><div class="label">Verification result</div><div class="value"><strong><%= sampleMode?'SAMPLE ONLY':valid?'GENUINE / VALID':document.status %></strong></div><div class="label">Document purpose</div><div class="value"><%= purpose %></div><div class="label">Document number</div><div class="value"><%= document.document_number %></div><div class="label">Full name</div><div class="value"><%= fullName %></div><div class="label">Application number</div><div class="value"><%= document.application_number||'—' %></div><div class="label">Application type</div><div class="value"><%= document.application_type||'—' %></div><div class="label">School</div><div class="value"><%= document.school_name||'Not specified' %></div><div class="label">Department</div><div class="value"><%= document.department_name||'Not specified' %></div><div class="label">Programme</div><div class="value"><%= document.programme_name||document.offered_programme_name||'Not specified' %></div><div class="label">Academic session</div><div class="value"><%= document.session_name||'—' %></div><div class="label">Issued</div><div class="value"><%= document.issued_at?new Date(document.issued_at).toLocaleDateString('en-GB'):'—' %></div></div><p class="foot">For enquiries about this verification result, please contact the College Registry.</p><% } %>
</div></section></main></body></html>
