<% const editing=editRow||{}; const localDate=v=>v?new Date(v).toISOString().slice(0,16):''; %>
<div class="row"><div class="col-lg-5"><div class="card card-outline card-success"><div class="card-header"><h3 class="card-title"><%= editRow?'Edit announcement':'New announcement' %></h3></div>
<form method="post" action="<%= editRow?`/staff/admissions/announcements/${editRow.id}/update`:'/staff/admissions/announcements' %>"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><div class="card-body">
<div class="form-group"><label>Title</label><input name="title" class="form-control" value="<%= editing.title||'' %>" required></div><div class="form-group"><label>Message</label><textarea name="body" class="form-control" rows="5" required><%= editing.body||'' %></textarea></div>
<div class="form-row"><div class="form-group col-md-6"><label>Audience</label><select name="audience_role" class="form-control"><% [['applicant','Applicants'],['student','Students'],['both','Applicants and students']].forEach(x=>{ %><option value="<%= x[0] %>" <%= editing.audience_role===x[0]?'selected':'' %>><%= x[1] %></option><% }) %></select></div><div class="form-group col-md-6"><label>Priority</label><select name="priority" class="form-control"><% ['NORMAL','IMPORTANT','URGENT'].forEach(x=>{ %><option <%= editing.priority===x?'selected':'' %>><%= x %></option><% }) %></select></div></div>
<div class="form-group"><label>Session</label><select name="session_id" class="form-control"><option value="">All sessions</option><% sessions.forEach(s=>{ %><option value="<%= s.id %>" <%= Number(editing.session_id)===Number(s.id)?'selected':'' %>><%= s.name %></option><% }) %></select></div>
<div class="form-row"><div class="form-group col-md-4"><label>School</label><select name="school_id" class="form-control"><option value="">All</option><% schools.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(editing.school_id)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div><div class="form-group col-md-4"><label>Department</label><select name="department_id" class="form-control"><option value="">All</option><% departments.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(editing.department_id)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div><div class="form-group col-md-4"><label>Programme</label><select name="programme_id" class="form-control"><option value="">All</option><% programmes.forEach(x=>{ %><option value="<%= x.id %>" <%= Number(editing.programme_id)===Number(x.id)?'selected':'' %>><%= x.name %></option><% }) %></select></div></div>
<div class="form-row"><div class="form-group col-6"><label>Publish at</label><input type="datetime-local" name="publish_at" value="<%= localDate(editing.publish_at) %>" class="form-control"></div><div class="form-group col-6"><label>Expire at</label><input type="datetime-local" name="expires_at" value="<%= localDate(editing.expires_at) %>" class="form-control"></div></div><div class="custom-control custom-checkbox"><input class="custom-control-input" id="announcePublish" type="checkbox" name="publish_now" value="1" <%= editing.status==='PUBLISHED'?'checked':'' %>><label class="custom-control-label" for="announcePublish">Publish now</label></div></div><div class="card-footer"><button class="btn btn-success"><%= editRow?'Update':'Save' %> announcement</button><% if(editRow){ %><a href="/staff/admissions/announcements" class="btn btn-light">Cancel</a><% } %></div></form></div></div>
<div class="col-lg-7"><div class="card modern-panel"><div class="card-header"><h3 class="card-title">Announcements</h3></div><div class="list-group list-group-flush"><% if(!rows.length){ %><div class="p-4 text-muted">No announcements saved.</div><% } rows.forEach(row=>{ %><div class="list-group-item"><div class="d-flex justify-content-between"><strong><%= row.title %></strong><span class="badge badge-<%= row.status==='PUBLISHED'?'success':'secondary' %>"><%= row.status %></span></div><p class="mb-1 mt-2"><%= row.body %></p><div class="d-flex align-items-center"><small class="text-muted"><%= row.audience_role %> · <%= row.session_name||'All sessions' %> · <%= row.programme_name||row.department_name||row.school_name||'All areas' %></small><a class="btn btn-sm btn-outline-primary ml-auto" href="/staff/admissions/announcements?edit=<%= row.id %>"><i class="fas fa-edit mr-1"></i>Edit</a></div></div><% }) %></div></div></div></div>
