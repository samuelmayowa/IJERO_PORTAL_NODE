<div class="card card-outline card-primary"><div class="card-header"><h3 class="card-title"><%= type[0].toUpperCase()+type.slice(1) %> passwords</h3></div><div class="card-body">
<form method="get" class="form-row mb-3"><div class="col-md-9"><input name="q" value="<%= q %>" class="form-control" placeholder="Search by name, <%= type==='staff'?'staff number':'matric number' %>, email or phone"></div><div class="col-md-3"><button class="btn btn-primary btn-block">Search</button></div></form>
<div class="alert alert-light border">A reset changes the selected user's password to <strong>College1</strong>.</div>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th><%= type==='staff'?'Staff number':'Matric number' %></th><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th></th></tr></thead><tbody><% if(!rows.length){ %><tr><td colspan="6" class="text-center text-muted py-4">No users found.</td></tr><% } %><% rows.forEach(row=>{ %><tr><td><%= row.identifier||'—' %></td><td><strong><%= row.name||'—' %></strong></td><td><%= row.email||'—' %></td><td><%= row.phone||'—' %></td><td><span class="badge badge-<%= row.status==='ACTIVE'?'success':'secondary' %>"><%= row.status %></span></td><td><form method="post" action="/staff/password/<%= type %>/<%= row.id %>/reset"><input type="hidden" name="_csrf" value="<%= csrfToken||'' %>"><button class="btn btn-sm btn-warning" onclick="return confirm('Reset this password to College1?')">Reset password</button></form></td></tr><% }) %></tbody></table></div>
<nav><ul class="pagination mb-0"><li class="page-item <%= page<=1?'disabled':'' %>"><a class="page-link" href="?q=<%= encodeURIComponent(q) %>&page=<%= page-1 %>">Previous</a></li><li class="page-item disabled"><span class="page-link">Page <%= page %> of <%= totalPages %></span></li><li class="page-item <%= page>=totalPages?'disabled':'' %>"><a class="page-link" href="?q=<%= encodeURIComponent(q) %>&page=<%= page+1 %>">Next</a></li></ul></nav>
</div></div>
